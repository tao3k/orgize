;;; Read inert authoring data into the existing POO constructors. Never eval.
(import (only-in :clan/poo/object .o .ref)
        (only-in :std/list/list find)
        (only-in :orgize/languages/org/modules/org-elements/runtime-interface
                 org-element-graph-records make-org-element-property-clause
                 make-org-element-relation-clause org-element-query-compose
                 org-element-predicate-all org-element-predicate-any)
        (only-in :orgize/languages/org/modules/org-elements/source-graph org-source-element-field)
        (only-in "values.ss" make-org-contract-definition
                 make-org-contract-assertion make-org-contract-binding
                 make-org-contract-expectation))
(export org-source-contract-definitions)

(def (declaration-error form) (error "not an inert Org Contract declaration" form))
(def (clause form)
  (unless (and (list? form) (pair? form)) (declaration-error form))
  (case (car form)
    ((property-local-path)
     (unless (and (= (length form) 2) (symbol? (cadr form))) (declaration-error form))
     (make-org-element-property-clause (symbol->string (cadr form)) "" 'local-path))
    ((property property-contains)
     (unless (and (= (length form) 3) (symbol? (cadr form)) (string? (caddr form)))
       (declaration-error form))
     (make-org-element-property-clause (symbol->string (cadr form)) (caddr form)
                                      (if (eq? (car form) 'property) 'exact 'contains)))
    ((at child-of descendant-of)
     (unless (and (= (length form) 2) (symbol? (cadr form))) (declaration-error form))
     (make-org-element-relation-clause (car form)
       (if (eq? (cadr form) 'scope) 'scope (symbol->string (cadr form)))))
    ((all-of any-of)
     ((if (eq? (car form) 'all-of) org-element-predicate-all org-element-predicate-any)
      (map clause (cdr form))))
    (else (declaration-error form))))
(def (query form)
  (unless (and (list? form) (>= (length form) 2)
               (eq? (car form) 'org-elements) (symbol? (cadr form)))
    (declaration-error form))
  (org-element-query-compose (symbol->string (cadr form)) (map clause (cddr form))))
(def (binding form)
  (unless (and (list? form) (= (length form) 3)
               (eq? (car form) 'bind) (symbol? (cadr form))) (declaration-error form))
  (make-org-contract-binding (symbol->string (cadr form)) (query (caddr form))))
(def (assertion form)
  (unless (and (list? form) (memv (length form) '(6 8))
               (eq? (car form) 'assert-org-element) (string? (cadr form))
               (memq (caddr form) '(error warning info))) (declaration-error form))
  (let ((bindings (list-ref form 3)) (expect (list-ref form 5)))
    (unless (and (list? bindings) (pair? bindings) (eq? (car bindings) 'bindings)
                 (list? expect) (= (length expect) 3) (eq? (car expect) 'expect)
                 (memq (cadr expect) '(at-least exactly at-most))
                 (exact-integer? (caddr expect)) (<= 0 (caddr expect) 4096))
      (declaration-error form))
    (let ((message #f) (fix #f))
      (when (= (length form) 8)
        (let ((m (list-ref form 6)) (f (list-ref form 7)))
          (unless (and (list? m) (= (length m) 2) (eq? (car m) 'message) (string? (cadr m))
                       (list? f) (= (length f) 2) (eq? (car f) 'fix) (string? (cadr f)))
            (declaration-error form))
          (set! message (cadr m)) (set! fix (cadr f))))
      (make-org-contract-assertion (cadr form) (caddr form) (query (list-ref form 4))
        (make-org-contract-expectation (cadr expect) (caddr expect))
        (map binding (cdr bindings)) message fix))))

(def (org-source-contract-definitions graph)
  (let (records (org-element-graph-records graph))
    (let loop ((rest records) (out '()))
      (if (null? rest) (reverse out)
        (let* ((record (car rest))
               (headers (org-source-element-field record "header-key")))
          (if (and (equal? (.ref record 'kind) "src-block")
                   (list? headers) (member "org-contract" headers))
            (let* ((owner (find (lambda (e) (equal? (.ref e 'id) (.ref record 'parent))) records))
                   (scope (and owner (org-source-element-field owner "property:CONTRACT_SCOPE")))
                   (id (and owner (org-source-element-field owner "property:CONTRACT_ID")))
                   (target-property (and owner (org-source-element-field owner "property:CONTRACT_TARGET_PROPERTY")))
                   (target-value (and owner (org-source-element-field owner "property:CONTRACT_TARGET_VALUE")))
                   (body (org-source-element-field record "body")))
              (unless (and (equal? (org-source-element-field record "language") "scheme")
                           id (member scope '("document" "subtree")) (string? body))
                (error "Org Contract source lacks ID, scope, language or body"))
              (unless (and (eq? (not target-property) (not target-value))
                           (or (not target-property)
                               (and (> (string-length target-property) 0)
                                    (> (string-length target-value) 0)))
                           (equal? (.ref owner 'kind) "headline"))
                (error "Org Contract applicability or owning section is invalid"))
              (let (assertions
                    (call-with-input-string body
                      (lambda (port)
                        (let read-next ((out '()))
                          (let (form (read port))
                            (if (eof-object? form) (reverse out)
                              (begin
                                (when (>= (length out) 256) (error "too many Org assertions"))
                                (read-next (cons (assertion form) out)))))))))
                (let ((definition (make-org-contract-definition id (string->symbol scope) assertions))
                      (owner-id-value (.ref owner 'id))
                      (target-property-value target-property)
                      (target-text-value target-value))
                  (loop (cdr rest)
                        (cons (.o (:: @ definition)
                                  source-scope-id: owner-id-value
                                  target-property: target-property-value
                                  target-value: target-text-value) out)))))
            (loop (cdr rest) out)))))))
