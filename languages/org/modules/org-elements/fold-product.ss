;;; -*- Gerbil -*-
;;; Source-backed document product for the host ABI.
(import (for-syntax
         (only-in :gerbil-parser/language-support/grammar language-grammar-ir)
         (only-in :gerbil-parser/graph-projection-support
                  graph-projection-digest graph-node-syntax-kind graph-node-fields
                  graph-field-token graph-field-name graph-field-mode)
         (only-in "../org-parser/grammar.ss" org-mode-language-grammar)
         (only-in "graph.ss" org-graph-projection)
         (only-in "graph-shape.ss" org-graph-shape)))
(export org-fold-product)

;; Resolve the producer's numeric kind and rule identities from the same
;; declarations that generate the host's catalog. Querying fields at runtime
;; is indexed by input kind and the currently open Element.
(defsyntax (define-fold-catalog stx)
  (syntax-case stx ()
    ((_ categories rules digest)
     (let* ((kinds (cdr (assq 'syntax-kinds (language-grammar-ir org-mode-language-grammar))))
            (count (length kinds))
            (indices (make-table test: eq?))
            (table (make-vector count #f)))
       (let index ((remaining kinds) (id 0))
         (unless (null? remaining)
           (table-set! indices (caar remaining) id)
           (index (cdr remaining) (+ id 1))))
       (let index ((remaining org-graph-shape) (id 0))
         (unless (null? remaining)
           (let* ((node (car remaining))
                  (fields (graph-node-fields node))
                  (inputs (make-table test: eqv?))
                  (names (make-table test: equal?))
                  (name-count 0)
                  (empty '()))
             (let collect ((remaining fields) (field-id 0))
               (unless (null? remaining)
                 (let* ((field (car remaining))
                        (input (table-ref indices (graph-field-token field)))
                        (mode (graph-field-mode field))
                        (name (graph-field-name field))
                        (group (or (table-ref names name #f)
                                   (begin0 name-count
                                     (table-set! names name name-count)
                                     (set! name-count (+ name-count 1)))))
                        (descriptor (vector field-id group mode)))
                   (when (eq? mode 'append-or-empty)
                     (set! empty (cons descriptor empty)))
                   (table-set! inputs input (cons descriptor (table-ref inputs input '())))
                   (collect (cdr remaining) (+ field-id 1)))))
             (vector-set! table (table-ref indices (graph-node-syntax-kind node))
                          (vector id
                                  (list->vector
                                   (map (lambda (index) (reverse (table-ref inputs index '())))
                                        (iota count)))
                                  (reverse empty) name-count
                                  (case (graph-node-syntax-kind node)
                                    ((OrgFile) 'document)
                                    ((OrgKeyword) 'keyword)
                                    ((OrgSection) 'headline)
                                    ((OrgPropertyDrawer) 'drawer)
                                    ((OrgNodeProperty) 'property)
                                    (else #f)))))
           (index (cdr remaining) (+ id 1))))
       (with-syntax ((tokens (datum->syntax #'categories
                               (list->vector (map (lambda (kind) (eq? (cadr kind) 'token)) kinds))))
                     (rows (datum->syntax #'rules table))
                     (identity (datum->syntax #'digest
                                 (graph-projection-digest org-mode-language-grammar
                                                          org-graph-projection))))
         #'(begin
             (def categories 'tokens)
             (def rules 'rows)
             (def digest (string->utf8 identity))))))))

(define-fold-catalog token-kinds element-rules projection-identity)

(defstruct element (rule parent start end subtree-end fields first-fields))
(defstruct field (ordinal spans))

;; Ledger consumes the leading section, its direct property drawer, and file
;; TODO directives (which may occur anywhere in the document). Preserve mapped
;; ownership for skipped frames so their tokens cannot leak to a kept Element.
(def (ledger-element? rule owner start)
  (let (parent-role (and owner (vector-ref (element-rule owner) 4)))
    (case (vector-ref rule 4)
      ((document keyword) #t)
      ((headline) (and (eq? parent-role 'document) (= start 0)))
      ((drawer) (eq? parent-role 'headline))
      ((property) (eq? parent-role 'drawer))
      (else #f))))

(def (add-field! owner descriptor start end)
  (let* ((mode (vector-ref descriptor 2))
         (group (vector-ref descriptor 1))
         (first-fields (or (element-first-fields owner)
                           (let (first (make-vector (vector-ref (element-rule owner) 3) #f))
                             (element-first-fields-set! owner first)
                             first)))
         (first (vector-ref first-fields group))
         (span (cons start end)))
    (if (and first (not (memq mode '(each each-node-text))))
      (field-spans-set! first (cons span (field-spans first)))
      (let (value (make-field (vector-ref descriptor 0) (list span)))
        ;; Append targets the first published value even if that value came
        ;; from an Each descriptor with the same field name.
        (unless first (vector-set! first-fields group value))
        (element-fields-set! owner (cons value (element-fields owner)))))))

(def (capture! owner kind start end)
  (let loop ((fields (vector-ref (vector-ref (element-rule owner) 1) kind)))
    (unless (null? fields)
      (add-field! owner (car fields) start end)
      (loop (cdr fields)))))

;; The tape is little-endian and the column writers use fixed-width words.
;; The caller admits capacity and the complete record before byte access.
(def (tape-kind bytes offset)
  (fxior (##u8vector-ref bytes offset)
         (fxarithmetic-shift-left (##u8vector-ref bytes (fx+ offset 1)) 8)))

(def (tape-offset bytes offset)
  (fxior (tape-kind bytes offset)
         (fxarithmetic-shift-left (tape-kind bytes (fx+ offset 2)) 16)))

(def (put-word! bytes offset value)
  (##u8vector-set! bytes offset (fxand value 255))
  (##u8vector-set! bytes (fx+ offset 1) (fxand (fxarithmetic-shift-right value 8) 255))
  (##u8vector-set! bytes (fx+ offset 2) (fxand (fxarithmetic-shift-right value 16) 255))
  (##u8vector-set! bytes (fx+ offset 3) (fxarithmetic-shift-right value 24)))

(def (put-pair! bytes offset first second)
  (put-word! bytes offset first)
  (put-word! bytes (fx+ offset 4) second))

(def (put-syntax-row! bytes offset kind parent start end subtree-end)
  (put-pair! bytes offset kind parent)
  (put-pair! bytes (fx+ offset 8) start end)
  (put-word! bytes (fx+ offset 16) subtree-end))

(def absent #xffffffff)
(def syntax-row-width 20)
(def fold-header-width 75)
(def document-header-width (+ fold-header-width 71 8))

(def (org-fold-product source-size tape ledger?)
  (unless (< source-size absent) (error "Org source exceeds the document ABI"))
  (def limit (u8vector-length tape))
  (def syntax (and (not ledger?) (make-u8vector 1024 0)))
  (def syntax-count 0)
  (def element-count 0)
  (def stack '())
  (def elements '())
  (def mapped '())
  (def position 0)
  (def (push-syntax! kind parent start end subtree-end)
    (when syntax
      (let* ((offset (* syntax-count syntax-row-width))
             (next (+ offset syntax-row-width)))
        (when (> next (u8vector-length syntax))
          (let (grown (make-u8vector (* 2 (u8vector-length syntax)) 0))
            (u8vector-copy! grown 0 syntax 0 offset)
            (set! syntax grown)))
        (put-syntax-row! syntax offset kind parent start end subtree-end)))
    (set! syntax-count (+ syntax-count 1)))
  (def navigation-count
    (let consume ((offset fold-header-width))
      (if (= offset limit) syntax-count
      (let (tag (u8vector-ref tape offset))
        (case tag
          ((0)
           (unless (pair? stack) (error "unbalanced Org Fold finish"))
           (let* ((frame (car stack)) (id (vector-ref frame 0))
                  (kind (vector-ref frame 1)) (start (vector-ref frame 2))
                  (rule (vector-ref element-rules kind)))
             (when syntax
               (let (row (* id syntax-row-width))
                 (put-pair! syntax (+ row 12) position syntax-count)))
             (let (owner (and (pair? mapped) (cdar mapped)))
               (when owner
                 (capture! owner kind start position)
                 (when rule
                   (let empty ((fields (vector-ref rule 2)))
                     (unless (null? fields)
                       (let ((first (element-first-fields owner))
                             (descriptor (car fields)))
                         (unless (and first (vector-ref first (vector-ref descriptor 1)))
                           (add-field! owner descriptor position position)))
                       (empty (cdr fields))))
                   (element-end-set! owner position)
                   (element-subtree-end-set! owner element-count))))
             (when rule (set! mapped (cdr mapped)))
             (set! stack (cdr stack))
             (consume (+ offset 1))))
          ((1 2)
           (unless (<= (+ offset (if (= tag 1) 3 19)) limit)
             (error "truncated Org Fold record"))
           (let (kind (tape-kind tape (+ offset 1)))
             (unless (eq? (vector-ref token-kinds kind) (= tag 2))
               (error "Org Fold kind category mismatch" kind tag))
             (if (= tag 1)
               (let ((parent (if (null? stack) absent (vector-ref (car stack) 0)))
                     (rule (vector-ref element-rules kind)))
                 (when (and (null? stack) (or (> syntax-count 0) (not rule)))
                   (error "invalid Org Fold root" kind))
                 (when rule
                   (let ((element-parent (if (null? mapped) absent (caar mapped)))
                         (owner (and (pair? mapped) (cdar mapped))))
                     (if (or (not ledger?) (ledger-element? rule owner position))
                       (let (row (make-element rule element-parent position 0 0 '() #f))
                         (set! mapped (cons (cons element-count row) mapped))
                         (set! elements (cons row elements))
                         (set! element-count (+ element-count 1)))
                       (set! mapped (cons (cons element-parent #f) mapped)))))
                 (set! stack (cons (vector syntax-count kind position) stack))
                 (push-syntax! kind parent position 0 0)
                 (consume (+ offset 3)))
               (let ((start (tape-offset tape (+ offset 3)))
                     (end (tape-offset tape (+ offset 11))))
                 (unless (and (pair? stack) (= start position) (< start end) (<= end source-size)
                              (= (tape-offset tape (+ offset 7)) 0)
                              (= (tape-offset tape (+ offset 15)) 0))
                   (error "invalid Org Fold token range" start end))
                 (push-syntax! kind (vector-ref (car stack) 0) start end (+ syntax-count 1))
                 (when (and (pair? mapped) (cdar mapped))
                   (capture! (cdar mapped) kind start end))
                 (set! position end)
                 (consume (+ offset 19))))))
          (else (error "unknown Org Fold event tag" tag)))))))
  (unless (and (pair? elements) (null? stack) (null? mapped) (= position source-size))
    (error "incomplete Org source coverage"))
  (def syntax-size (if syntax (* navigation-count syntax-row-width) 0))
  (def elements-offset (+ document-header-width syntax-size))
  (def size
    (foldl (lambda (row total)
             (foldl (lambda (value total) (+ total 8 (* 8 (length (field-spans value)))))
                    (+ total 24) (element-fields row)))
           elements-offset elements))
  (def bytes (make-u8vector size 0))
  (u8vector-copy! bytes 0 (u8vector 79 68 86 49)) ; ODV1
  (u8vector-copy! bytes 4 tape 4 fold-header-width)
  (u8vector-copy! bytes fold-header-width projection-identity)
  (put-pair! bytes (- document-header-width 8) (if syntax navigation-count 0) element-count)
  (when syntax
    (u8vector-copy! bytes document-header-width syntax 0 syntax-size))
  (let write ((rest (reverse! elements)) (offset elements-offset))
    (unless (null? rest)
      (let* ((element (car rest))
             (fields (reverse! (element-fields element)))
             (next (let fields-loop ((rest fields) (offset (+ offset 24)))
                     (if (null? rest) offset
                       (let* ((value (car rest)) (spans (field-spans value)))
                         (put-pair! bytes offset (field-ordinal value) (length spans))
                         (fields-loop
                          (cdr rest)
                          (let span-loop ((spans (reverse! spans)) (offset (+ offset 8)))
                            (if (null? spans) offset
                              (begin
                                (put-pair! bytes offset (caar spans) (cdar spans))
                                (span-loop (cdr spans) (+ offset 8)))))))))))
        (put-syntax-row! bytes offset (vector-ref (element-rule element) 0)
                         (element-parent element) (element-start element)
                         (element-end element) (element-subtree-end element))
        (put-word! bytes (+ offset 20) (length fields))
        (write (cdr rest) next))))
  bytes)
