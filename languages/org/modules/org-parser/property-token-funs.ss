;;; -*- Gerbil -*-
;;; Pure property-list, cookie and parameter syntax shared by native consumers.
(import (only-in "text-funs.ss" org-trim org-space? org-find)
        (only-in "duration-funs.ss" value-digit?))
(export org-ascii-lower org-value-words org-trim-marks org-parameter-text
        org-unsigned-value org-property-tokens org-clock-property-names
        org-descriptor-key org-descriptor-name org-statistic-cookie org-tag-values)
(def (org-ascii-lower text)
  (list->string (map (lambda (ch) (if (char<=? #\A ch #\Z)
                                 (integer->char (+ (char->integer ch) 32)) ch))
                    (string->list text))))
(def (org-trim-marks text marks (left? #t) (right? #t))
  (let (end (string-length text))
    (let left ((start 0))
      (if (and left? (< start end) (memv (string-ref text start) marks))
        (left (+ start 1))
        (let right ((until end))
          (if (and right? (> until start) (memv (string-ref text (- until 1)) marks))
            (right (- until 1)) (substring text start until)))))))
(def (org-parameter-text raw)
  (org-trim (org-trim-marks (org-trim-marks (org-trim raw) '(#\")) '(#\'))))
(def (org-value-words text)
  (let (end (string-length text))
    (let loop ((i 0) (start #f) (words '()))
      (cond ((= i end) (reverse (if start (cons (substring text start end) words) words)))
            ((org-space? (string-ref text i))
             (loop (+ i 1) #f (if start (cons (substring text start i) words) words)))
            (else (loop (+ i 1) (or start i) words))))))
(def (org-unsigned-value raw max)
  (let* ((text (org-trim raw)) (end (string-length text))
         (start (if (and (> end 0) (char=? (string-ref text 0) #\+)) 1 0)))
    (and (< start end) (andmap value-digit? (string->list (substring text start end)))
         (let (n (string->number (substring text start end))) (and (<= n max) n)))))
(def (quoted-tokens text strict? keep-empty?)
  (let (end (string-length text))
    (let loop ((i 0) (quotation #f) (escaped? #f) (started? #f) (token '()) (tokens '()))
      (def (add-token tokens token started?)
        (if (and started? (or keep-empty? (pair? token)))
          (cons (list->string (reverse token)) tokens) tokens))
      (if (= i end)
        (and (or (not strict?) (not quotation))
             (reverse (add-token tokens (if escaped? (cons #\\ token) token) started?)))
        (let (ch (string-ref text i))
          (cond (escaped? (loop (+ i 1) quotation #f #t (cons ch token) tokens))
                ((char=? ch #\\) (loop (+ i 1) quotation #t #t token tokens))
                ((eqv? quotation ch) (loop (+ i 1) #f #f #t token tokens))
                ((and (not quotation) (memv ch '(#\" #\'))) (loop (+ i 1) ch #f #t token tokens))
                ((and (not quotation) (org-space? ch))
                 (loop (+ i 1) #f #f #f '() (add-token tokens token started?)))
                (else (loop (+ i 1) quotation #f #t (cons ch token) tokens))))))))
(def (org-property-tokens value) (quoted-tokens value #f #t))
(def (org-clock-property-names raw)
  (let* ((text (org-trim raw)) (end (string-length text))
         (text (if (and (> end 0) (char=? (string-ref text 0) #\'))
                 (org-trim (substring text 1 end)) text))
         (end (string-length text)))
    (cond ((string=? (org-ascii-lower (org-trim raw)) "nil") '())
          ((and (>= end 2) (char=? (string-ref text 0) #\()
                (char=? (string-ref text (- end 1)) #\)))
           (let (tokens (quoted-tokens (org-trim (substring text 1 (- end 1))) #t #f))
             (and tokens (andmap (lambda (token) (not (or (org-find token "(") (org-find token ")"))))
                                        tokens) tokens)))
          (else #f))))
(def (org-descriptor-key raw) (string-append (org-trim-marks raw '(#\+) #f #t) "_ALL"))
(def (org-descriptor-name raw)
  (let* ((text (org-trim-marks raw '(#\+) #f #t)) (end (string-length text)))
    (and (> end 4) (string=? (org-ascii-lower (substring text (- end 4) end)) "_all")
         (substring text 0 (- end 4)))))
(def (org-statistic-cookie raw)
  (let* ((text (org-trim-marks (org-trim-marks (org-trim raw) '(#\[) #t #f) '(#\]) #f #t))
         (end (string-length text))
         (percent (and (> end 0) (char=? (string-ref text (- end 1)) #\%)
                       (org-unsigned-value (substring text 0 (- end 1)) 100)))
         (split (org-find text "/"))
         (done (and split (org-unsigned-value (substring text 0 split) 4294967295)))
         (total (and split (org-unsigned-value (substring text (+ split 1) end) 4294967295))))
    (cond (percent (list "percent" "" "" (number->string percent)))
          ((and done total) (list "fraction" (number->string done) (number->string total) ""))
          (else (list "unknown" "" "" "")))))
(def (org-tag-values raw)
  (let* ((text (org-trim raw)) (end (string-length text)))
    (if (and (> end 0) (char=? (string-ref text 0) #\:)
             (char=? (string-ref text (- end 1)) #\:))
      (let loop ((start 0) (tokens '()))
        (let* ((next (org-find text ":" start))
               (part (substring text start (or next end)))
               (tokens (if (string=? part "") tokens (cons part tokens))))
          (if next (loop (+ next 1) tokens) (reverse tokens))))
      (list text))))
