;;; -*- Gerbil -*-
;;; Pure, non-executing citation export policy; indexed final ABI rows.
(import (only-in "property-token-funs.ss" org-value-words org-ascii-lower))
(export org-citation-export-keywords org-citation-nocite)

(def (strip-edge text char)
  (let (end (string-length text))
    (let left ((start 0))
      (if (and (< start end) (char=? (string-ref text start) char))
        (left (+ start 1))
        (let right ((until end))
          (if (and (> until start) (char=? (string-ref text (- until 1)) char))
            (right (- until 1)) (substring text start until)))))))
(def (citation-words raw)
  ;; Preserve whitespace-first tokenization, not a new quoted-path grammar.
  (filter (lambda (word) (not (string=? word "")))
          (map (lambda (word) (strip-edge word #\")) (org-value-words raw))))
(def (option-token? word)
  (and (> (string-length word) 0) (char=? (string-ref word 0) #\:)))
(def (option-key word)
  (let loop ((start 0))
    (if (and (< start (string-length word)) (char=? (string-ref word start) #\:))
      (loop (+ start 1)) (substring word start (string-length word)))))
(def (citation-keyword key raw)
  (let ((key (org-ascii-lower key)) (words (citation-words raw)))
    (cond
      ((string=? key "bibliography") (list (cons "bibliography" words)))
      ((string=? key "cite_export")
       (list (if (null? words) '("processor" "" "none")
               (if (null? (cdr words)) (list "processor" (car words) "none")
                 (list "processor" (car words) "some" (string-join (cdr words) " "))))))
      ((string=? key "print_bibliography")
       (cons '("print")
             (let loop ((words words) (rows '()))
               (cond ((null? words) (reverse rows))
                     ((not (option-token? (car words))) (loop (cdr words) rows))
                     (else
                      (let* ((raw (car words)) (rest (cdr words))
                             (value? (and (pair? rest) (not (option-token? (car rest))))))
                        (loop (if value? (cdr rest) rest)
                              (cons (if value?
                                      (list "option" (option-key raw) raw "some" (car rest))
                                      (list "option" (option-key raw) raw "none")) rows))))))))
      (else '()))))
(def (org-citation-export-keywords fields)
  (let loop ((fields fields) (index 0) (rows '()))
    (if (null? fields) (reverse rows)
      (loop (cddr fields) (+ index 1)
            (foldl (lambda (row rows) (cons (cons (number->string index) row) rows))
                   rows (citation-keyword (car fields) (cadr fields)))))))
(def (org-citation-nocite styles)
  (map (lambda (style) (list (if (string=? (org-ascii-lower style) "nocite") "true" "false")))
       styles))
