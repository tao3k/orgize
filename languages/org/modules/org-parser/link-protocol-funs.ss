;;; -*- Gerbil -*-
;;; Inert URI and org-protocol structure; decoding stays an explicit host codec.
(import (only-in "text-funs.ss" org-trim org-find)
        (only-in "property-token-funs.ss" org-ascii-lower org-trim-marks))
(export org-uri-parts org-link-protocol-kind org-protocol-plan)
(def (org-uri-parts raw)
  (let (colon (org-find raw ":"))
    (and colon (list (substring raw 0 colon)
                     (substring raw (+ colon 1) (string-length raw))))))
(def (org-link-protocol-kind protocol abbreviation?)
  (unless (member abbreviation? '("true" "false")) (error "invalid abbreviation flag"))
  (cond ((string=? abbreviation? "true") "abbreviation")
        ((member protocol '("file" "file+sys" "file+emacs" "file+shell")) "file")
        ((string=? protocol "attachment") "attachment")
        ((string=? protocol "id") "internal-id")
        ((string=? protocol "coderef") "code-reference")
        ((member protocol '("http" "https" "ftp" "doi" "irc")) "web")
        ((member protocol '("mailto" "news" "gnus" "rmail" "mhe" "bbdb")) "message")
        ((member protocol '("docview" "help" "info" "shortdoc")) "documentation")
        ((member protocol '("shell" "elisp")) "executable")
        ((string=? protocol "org-protocol") "org-protocol")
        (else "custom")))
(def (org-protocol-parameters body)
  (let ((query (org-find body "?")) (end (string-length body)))
    (if (not query) '()
      (let loop ((start (+ query 1)) (rows '()))
        (let* ((next (org-find body "&" start)) (part (substring body start (or next end)))
               (equal (org-find part "="))
               (row (list part (if equal (substring part 0 equal) part)
                          (if equal (substring part (+ equal 1) (string-length part)) "")
                          (if equal "true" "false")))
               (rows (if (string=? part "") rows (cons row rows))))
          (if next (loop (+ next 1) rows) (reverse rows)))))))
(def (org-protocol-plan raw mode)
  (unless (member mode '("raw" "target")) (error "invalid org-protocol mode"))
  (let* ((parts (and (string=? mode "raw") (org-uri-parts (org-trim raw))))
         (target (if (string=? mode "target") raw
                   (and parts (string=? (org-ascii-lower (car parts)) "org-protocol") (cadr parts)))))
    (if (not target) '()
      (let* ((body (org-trim-marks target '(#\/) #t #f)) (end (string-length body))
             (until (let loop ((i 0))
                      (if (or (= i end) (memv (string-ref body i) '(#\? #\/ #\:))) i
                        (loop (+ i 1)))))
             (subprotocol (org-trim (substring body 0 until)))
             (kind (if (member subprotocol '("store-link" "capture" "open-source")) subprotocol "custom")))
        (if (string=? subprotocol "") '()
          (cons (list subprotocol kind) (org-protocol-parameters body)))))))
