;;; -*- Gerbil -*-
;;; Org TAGS vocabulary is source-backed Scheme event syntax, not a Rust lexer.

(import (only-in "objects.ss" make-org-event-helper))
(export tag-vocabulary-event-helper)

(def tag-index '(line-index tag-byte-index))
(def tag-next `(line-step ,tag-index))
(def tag-start '(state-offset tag-start))

(def (tag-flush-name (reset? #t))
  `((if (uint-equal? (state tag-mode) (uint 1))
        ((token TagName ,tag-start ,tag-index)) ())
    ,@(if reset? '((set-uint tag-mode (uint 0))) '())))

(def (tag-punctuation kind)
  `(,@(tag-flush-name)
    (token ,kind ,tag-index ,tag-next)))

(def (tag-step)
  `((if (line-bytes-any-in? ,tag-index ,tag-next (9 32))
        (,@(tag-flush-name)
         (token TagTrivia ,tag-index ,tag-next))
        ((if (line-byte-equal? ,tag-index 123)
             (,@(tag-flush-name)
              (start-node OrgTagExclusiveGroup)
              (token TagGroupOpen ,tag-index ,tag-next)
              (push-frame tag-frames (uint 1)))
             ((if (line-byte-equal? ,tag-index 91)
                  (,@(tag-flush-name)
                   (start-node OrgTagInclusiveGroup)
                   (token TagGroupOpen ,tag-index ,tag-next)
                   (push-frame tag-frames (uint 2)))
                  ((if (or (line-byte-equal? ,tag-index 125)
                           (line-byte-equal? ,tag-index 93))
                       (,@(tag-punctuation 'TagGroupClose)
                        (if (uint-positive? (stack-top tag-frames))
                            ((pop-frame tag-frames) (finish-node)) ()))
                       ((if (line-byte-equal? ,tag-index 58)
                            ,(tag-punctuation 'TagGroupSeparator)
                            ((if (line-byte-equal? ,tag-index 40)
                                 (,@(tag-flush-name #f)
                                  (token TagShortcutOpen ,tag-index ,tag-next)
                                  (set-uint tag-start (offset ,tag-next))
                                  (set-uint tag-mode (uint 2)))
                                 ((if (and (line-byte-equal? ,tag-index 41)
                                           (uint-equal? (state tag-mode) (uint 2)))
                                      ((token TagShortcut ,tag-start ,tag-index)
                                       (token TagShortcutClose ,tag-index ,tag-next)
                                       (set-uint tag-mode (uint 0)))
                                      ((if (uint-equal? (state tag-mode) (uint 0))
                                           ((set-uint tag-start (offset ,tag-index))
                                            (set-uint tag-mode (uint 1))) ())))))))))))))))))

(def tag-vocabulary-event-helper
  (make-org-event-helper
   'tag-vocabulary
   '((tag-start 0) (tag-mode 0)
     (tag-frames (uint-stack)))
   `((start-node OrgTagVocabulary)
     (for-line-bytes tag-byte-index start end ,(tag-step))
     (if (uint-equal? (state tag-mode) (uint 1))
         ((token TagName ,tag-start end)) ())
     (close-all-frames tag-frames 1)
     (finish-node))))
