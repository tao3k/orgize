;;; -*- Gerbil -*-
;;; Inert Agenda match grammar. No reader, evaluator or host query execution.
(import (only-in "text-funs.ss" org-trim org-prefix-at? org-find))
(export org-agenda-match)
(def (ascii-space? ch) (memv (char->integer ch) '(9 10 11 12 13 32)))
(def (byte-index text i) (u8vector-length (string->utf8 (substring text 0 i))))
(def (scan-end text start separators)
  (let (n (string-length text))
    (let loop ((i start) (quote? #f) (depth 0))
      (if (= i n) i
        (let (ch (string-ref text i))
          (cond ((and (char=? ch #\") (= depth 0)) (loop (+ i 1) (not quote?) depth))
                ((and (char=? ch #\{) (not quote?)) (loop (+ i 1) quote? (+ depth 1)))
                ((and (char=? ch #\}) (not quote?)) (loop (+ i 1) quote? (max 0 (- depth 1))))
                ((and (not quote?) (= depth 0) (memv ch separators)) i)
                (else (loop (+ i 1) quote? depth))))))))
(def (clauses text)
  (let (n (string-length text))
    (let loop ((start 0) (out '()))
      (let* ((end (scan-end text start '(#\|))) (entry (list (byte-index text start) (org-trim (substring text start end)))))
        (if (= end n) (reverse (cons entry out)) (loop (+ end 1) (cons entry out)))))))
(def (operator-at text i)
  (let loop ((ops '(("<=" "le") (">=" "ge") ("<>" "ne") ("!=" "ne") ("/=" "ne")
                    ("==" "eq") ("=" "eq") ("<" "lt") (">" "gt"))))
    (and (pair? ops)
         (let* ((op (car ops)) (needle (car op)) (size (string-length needle))
                (next (+ i size)))
           (if (org-prefix-at? text needle i)
             (list i (cadr op) (+ size (if (org-prefix-at? text "*" next) 1 0)))
             (loop (cdr ops)))))))
(def (find-operator text)
  (let (n (string-length text))
    (let loop ((i 0) (quote? #f) (depth 0))
      (and (< i n)
           (let* ((ch (string-ref text i))
                  (quote? (if (and (char=? ch #\") (= depth 0)) (not quote?) quote?))
                  (depth (cond ((and (char=? ch #\{) (not quote?)) (+ depth 1))
                               ((and (char=? ch #\}) (not quote?)) (max 0 (- depth 1))) (else depth)))
                  (op (and (not quote?) (= depth 0) (operator-at text i))))
             (or op (loop (+ i 1) quote? depth)))))))
(def (match-value raw)
  (let ((n (string-length raw)))
    (cond ((and (>= n 2) (org-prefix-at? raw "\"" 0) (org-prefix-at? raw "\"" (- n 1)))
           (list "quoted" (substring raw 1 (- n 1))))
          ((and (>= n 2) (org-prefix-at? raw "{" 0) (org-prefix-at? raw "}" (- n 1)))
           (list "pattern" (substring raw 1 (- n 1))))
          (else (list "bare" raw)))))
(def (org-agenda-match input)
  (let (source (org-trim input))
    (call/cc
     (lambda (return)
       (def (fail position message)
         (return (list (list "error" (number->string position) message))))
       (when (string=? source "") (fail 0 "match expression is empty"))
       (def (clause-rows clause base clause-id)
         (let (n (string-length clause))
           (let loop ((cursor 0) (out '()))
             (let skip ((cursor cursor))
               (cond ((and (< cursor n) (or (ascii-space? (string-ref clause cursor))
                                           (char=? (string-ref clause cursor) #\&))) (skip (+ cursor 1)))
                     ((= cursor n) (if (null? out) (fail base "match clause is empty") (reverse out)))
                     (else
                      (let* ((ch (string-ref clause cursor)) (signed? (memv ch '(#\+ #\-)))
                             (positive (if (char=? ch #\-) "false" "true"))
                             (start (let spaces ((i (if signed? (+ cursor 1) cursor)))
                                      (if (and (< i n) (ascii-space? (string-ref clause i))) (spaces (+ i 1)) i)))
                             (end (scan-end clause start '(#\+ #\- #\&)))
                             (raw (org-trim (substring clause start end)))
                             (position (+ base (byte-index clause start))))
                        (when (string=? raw "") (fail position "empty match term"))
                        (let* ((op (find-operator raw))
                               (prefix (list "term" (number->string clause-id) positive))
                               (row (if (not op) (append prefix (list "tag" raw "" "" ""))
                                      (let* ((value-start (+ (car op) (caddr op)))
                                             (key (org-trim (substring raw 0 (car op))))
                                             (value (org-trim (substring raw value-start (string-length raw)))))
                                        (when (string=? key "") (fail position "property match is missing a key"))
                                        (when (string=? value "")
                                          (fail (+ position (byte-index raw value-start)) "property match is missing a value"))
                                        (append prefix (list "property" key (cadr op)) (match-value value))))))
                          (loop end (cons row out))))))))))
       (let loop ((parts (clauses source)) (i 0) (out '()))
         (if (null? parts) (cons (list "source" source) (reverse out))
           (let* ((part (car parts)) (rows (clause-rows (cadr part) (car part) i)))
             (loop (cdr parts) (+ i 1) (append (reverse rows) out)))))))))
