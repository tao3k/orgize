;;; -*- Gerbil -*-
;;; Private duration grammar; native Scheme owns recognition and normalization.
(import (only-in "text-funs.ss" org-trim org-prefix-at?))
(export org-duration-seconds value-digit? value-digit-end value-two-digits
        value-ascii-space-end decimal-number)
(def u64-max 18446744073709551615)
(def (value-digit? ch) (char<=? #\0 ch #\9))
(def (value-digit-end text start)
  (let loop ((i start))
    (if (and (< i (string-length text)) (value-digit? (string-ref text i)))
      (loop (+ i 1)) i)))
(def (value-two-digits text start)
  (and (<= (+ start 2) (string-length text))
       (value-digit? (string-ref text start)) (value-digit? (string-ref text (+ start 1)))
       (- (+ (* 10 (char->integer (string-ref text start)))
             (char->integer (string-ref text (+ start 1)))) 528)))
(def (value-ascii-space-end text start)
  (let loop ((i start))
    (if (and (< i (string-length text))
             (memv (char->integer (string-ref text i)) '(9 10 11 12 13 32)))
      (loop (+ i 1)) i)))
(def (decimal-end text start)
  (let* ((before (value-digit-end text start))
         (after (if (and (< before (string-length text))
                         (char=? (string-ref text before) #\.))
                  (value-digit-end text (+ before 1)) before)))
    (and (or (> before start) (> after (+ before 1))) after)))
;; Do not admit Scheme reader numbers (radix, rational, complex or exactness).
(def (decimal-number text)
  (let* ((end (string-length text))
         (start (if (and (> end 0) (memv (string-ref text 0) '(#\+ #\-))) 1 0))
         (mantissa (decimal-end text start)))
    (and mantissa
         (let (until
               (if (and (< mantissa end) (memv (string-ref text mantissa) '(#\e #\E)))
                 (let* ((pos (+ mantissa 1))
                        (digits (if (and (< pos end) (memv (string-ref text pos) '(#\+ #\-)))
                                  (+ pos 1) pos))
                        (next (value-digit-end text digits)))
                   (and (> next digits) next)) mantissa))
           (and until (= until end)
                (let (n (string->number text))
                  (and n (real? n) (exact->inexact n))))))))
(def (hms-at text start)
  (let* ((hours-end (value-digit-end text start))
         (end (string-length text)))
    (and (> hours-end start) (< hours-end end)
         (char=? (string-ref text hours-end) #\:)
         (let* ((hours (string->number (substring text start hours-end)))
                (minute-start (+ hours-end 1))
                (minutes (value-two-digits text minute-start))
                (after-minute (+ minute-start 2)))
           (and (<= hours u64-max) minutes
                (if (and (< after-minute end) (char=? (string-ref text after-minute) #\:))
                  (let (seconds (value-two-digits text (+ after-minute 1)))
                    (and seconds
                         (cons (+ (* (exact->inexact hours) 60.0) minutes (/ seconds 60.0))
                               (+ after-minute 3))))
                  (cons (+ (* (exact->inexact hours) 60.0) minutes) after-minute)))))))
(def duration-units '(("min" . 1.0) ("h" . 60.0) ("d" . 1440.0)
                     ("w" . 10080.0) ("m" . 43200.0) ("y" . 525960.0)))
(def (duration-minutes text)
  (let* ((end (string-length text)) (hms (hms-at text 0))
         (decimal (decimal-number text)))
    (cond ((= end 0) 0.0)
          ((and hms (= (value-ascii-space-end text (cdr hms)) end)) (car hms))
          (decimal decimal)
          (else
           (let loop ((start 0) (total 0.0) (seen? #f))
             (let* ((i (value-ascii-space-end text start))
                    (tail (and seen? (hms-at text i))))
               (cond ((= i end) (and seen? total))
                     ((and tail (= (value-ascii-space-end text (cdr tail)) end))
                      (+ total (car tail)))
                     (else
                      (let (after (decimal-end text i))
                        (and after
                             (let* ((n (decimal-number (substring text i after)))
                                    (unit-start (value-ascii-space-end text after))
                                    (unit (ormap (lambda (u) (and (org-prefix-at? text (car u) unit-start) u))
                                                duration-units)))
                               (and n unit
                                    (loop (+ unit-start (string-length (car unit)))
                                          (+ total (* n (cdr unit))) #t)))))))))))))
(def (org-duration-seconds raw)
  (let* ((text (org-trim raw)) (minutes (duration-minutes text)))
    (and minutes (>= minutes 0.0) (< minutes +inf.0)
         ;; Rust's negative-zero rejection and saturating u64 normalization.
         (not (and (= minutes 0.0) (> (string-length text) 0)
                   (char=? (string-ref text 0) #\-)))
         (let (seconds (* minutes 60.0))
           (if (>= seconds (exact->inexact u64-max)) u64-max
             (let* ((whole (floor seconds)) (fraction (- seconds whole)))
               (inexact->exact (+ whole (if (>= fraction 0.5) 1.0 0.0)))))))))
