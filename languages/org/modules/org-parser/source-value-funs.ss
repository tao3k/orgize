;;; -*- Gerbil -*-
;;; Private source-value syntax. All recognition stays native and inert.
(import (only-in "text-funs.ss" org-trim org-space? org-find org-prefix-at?)
        (only-in "property-token-funs.ss" org-unsigned-value org-ascii-lower org-value-words)
        (only-in "duration-funs.ss" decimal-number))
(export org-source-tokens org-unquote org-variable org-noweb org-var-target
        org-include-lines org-include-mode org-column-list org-radio-marker
        org-plot-options org-radio-header org-radio-options org-option-kind)
(def (org-unquote raw)
  (let* ((text (org-trim raw)) (n (string-length text)))
    (if (and (>= n 2) (memv (string-ref text 0) '(#\" #\'))
             (eqv? (string-ref text 0) (string-ref text (- n 1))))
      (substring text 1 (- n 1)) text)))
;; Raw PLOT tokens preserve quoting, escapes and nested parentheses.
(def (org-source-tokens text)
  (let (n (string-length text))
    (let loop ((i 0) (start #f) (q #f) (escape? #f) (depth 0) (out '()))
      (if (= i n) (reverse (if start (cons (org-trim (substring text start n)) out) out))
        (let* ((ch (string-ref text i)) (start (or start (and (not (org-space? ch)) i))))
          (cond (escape? (loop (+ i 1) start q #f depth out))
                ((char=? ch #\\) (loop (+ i 1) start q #t depth out))
                ((eqv? q ch) (loop (+ i 1) start #f #f depth out))
                ((and (not q) (memv ch '(#\" #\'))) (loop (+ i 1) start ch #f depth out))
                ((and (not q) (char=? ch #\()) (loop (+ i 1) start q #f (+ depth 1) out))
                ((and (not q) (char=? ch #\))) (loop (+ i 1) start q #f (max 0 (- depth 1)) out))
                ((and (not q) (= depth 0) (org-space? ch))
                 (loop (+ i 1) #f #f #f 0 (if start (cons (org-trim (substring text start i)) out) out)))
                (else (loop (+ i 1) start q #f depth out))))))))
(def (org-variable raw)
  (let* ((text (org-trim raw)) (pos (org-find text "=")))
    (if pos (list (org-trim (substring text 0 pos))
                  (org-trim (substring text (+ pos 1) (string-length text))) "true")
      (list text "" "false"))))
(def (target-name raw delimiter)
  (let* ((pos (org-find raw delimiter))
         (text (org-trim (if pos (substring raw 0 pos) raw))))
    (and (not (string=? text "")) (not (ormap org-space? (string->list text))) text)))
(def (org-noweb text)
  (let loop ((i 0) (out '()))
    (let (start (org-find text "<<" i))
      (if (not start) (reverse out)
        (let (end (org-find text ">>" (+ start 2)))
          (if (not end) (reverse out)
            (let (name (target-name (org-trim (substring text (+ start 2) end)) "("))
              (loop (+ end 2) (if name (cons name out) out)))))))))
(def (balanced-call? text)
  (let (n (string-length text))
    (let loop ((i 0) (p 0) (b 0) (q #f) (escape? #f))
      (cond ((or (< p 0) (< b 0)) #f)
            ((= i n) (and (= p 0) (= b 0) (not q) (not escape?)))
            (else
             (let (ch (string-ref text i))
               (cond (escape? (loop (+ i 1) p b q #f))
                     ((char=? ch #\\) (loop (+ i 1) p b q #t))
                     ((eqv? q ch) (loop (+ i 1) p b #f #f))
                     ((and (not q) (memv ch '(#\" #\'))) (loop (+ i 1) p b ch #f))
                     (q (loop (+ i 1) p b q #f))
                     (else (loop (+ i 1)
                                 (+ p (cond ((char=? ch #\() 1) ((char=? ch #\)) -1) (else 0)))
                                 (+ b (cond ((char=? ch #\[) 1) ((char=? ch #\]) -1) (else 0)))
                                 #f #f)))))))))
(def (literal? text)
  (or (memv (string-ref text 0) '(#\" #\' #\[ #\( #\{ #\*))
      (member (org-ascii-lower text) '("nil" "t" "true" "false" "nan" "+nan" "-nan"
                                    "inf" "+inf" "-inf" "infinity" "+infinity" "-infinity"))
      (decimal-number text)))
;; Return recognition and matching policy, not a Rust source classifier.
(def (org-var-target raw)
  (let* ((text (org-trim raw)) (n (string-length text)) (open (org-find text "("))
         (call? (and open (> n 0) (char=? (string-ref text (- n 1)) #\))
                     (balanced-call? text)))
         (name (target-name (if call? (substring text 0 open) text) "[")))
    (and (> n 0) (not (literal? text)) name (not (org-find name ":"))
         (list name (if call? "call" "named")))))
(def (org-include-lines raw)
  (let* ((text (org-trim raw)) (pos (org-find text "-"))
         (start (and pos (org-unsigned-value (substring text 0 pos) 18446744073709551615)))
         (end (and pos (org-unsigned-value (substring text (+ pos 1) (string-length text)) 18446744073709551615))))
    (if (or (and start (> start 0)) (and end (> end 0)))
      (list "range" (if (and start (> start 0)) (number->string start) "")
            (if (and end (> end 0)) (number->string end) ""))
      (list "invalid" "" ""))))
(def (org-include-mode fields)
  (if (null? fields) "org"
    (let (kind (org-ascii-lower (car fields))) (if (member kind '("example" "src" "export")) kind "other"))))
(def (org-column-list raw)
  (let* ((text (org-trim raw)) (n (string-length text))
         (text (if (and (>= n 2) (char=? (string-ref text 0) #\()
                         (char=? (string-ref text (- n 1)) #\))) (substring text 1 (- n 1)) raw)))
    (let loop ((i 0) (start 0) (out '()))
      (if (= i (string-length text))
        (let (v (org-unsigned-value (substring text start i) 18446744073709551615))
          (reverse (if (and v (> v 0)) (cons (number->string v) out) out)))
        (if (or (org-space? (string-ref text i)) (char=? (string-ref text i) #\,))
          (let (v (org-unsigned-value (substring text start i) 18446744073709551615))
            (loop (+ i 1) (+ i 1) (if (and v (> v 0)) (cons (number->string v) out) out)))
          (loop (+ i 1) start out))))))
(def (org-radio-marker raw marker)
  (let (pos (org-find (org-ascii-lower raw) (org-ascii-lower marker)))
    (and pos
         (let* ((tokens (org-value-words (substring raw (+ pos (string-length marker)) (string-length raw))))
                (name (and (pair? tokens) (car tokens))))
           (and name
                (let* ((allowed? (lambda (ch) (or (char<=? #\a ch #\z) (char<=? #\A ch #\Z)
                                                  (char<=? #\0 ch #\9) (memv ch '(#\_ #\- #\.)))))
                       (n (string-length name)))
                  (let left ((i 0))
                    (if (and (< i n) (not (allowed? (string-ref name i)))) (left (+ i 1))
                      (let right ((end n))
                        (if (and (> end i) (not (allowed? (string-ref name (- end 1))))) (right (- end 1))
                          (and (> end i) (substring name i end))))))))))))

(def (org-plot-options raw)
  (filter-map
   (lambda (token)
     (let (pos (org-find token ":"))
       (and pos (list (org-trim (substring token 0 pos))
                      (org-unquote (substring token (+ pos 1) (string-length token))) token))))
   (org-source-tokens raw)))
(def (org-radio-header raw)
  (let (tokens (org-source-tokens raw))
    (and (>= (length tokens) 2) (string=? (org-ascii-lower (car tokens)) "send")
         (list (cadr tokens) (if (>= (length tokens) 3) (caddr tokens) "")
               (if (>= (length tokens) 3) "true" "false")))))
(def (org-radio-options raw)
  (let* ((tokens (org-source-tokens raw)) (tokens (if (> (length tokens) 3) (cdddr tokens) '())))
    (let loop ((rest tokens) (out '()))
      (if (null? rest) (reverse out)
        (let* ((token (car rest)) (n (string-length token)))
          (if (and (> n 1) (char=? (string-ref token 0) #\:))
            (let* ((next (and (pair? (cdr rest)) (cadr rest)))
                   (value? (and next (not (org-prefix-at? next ":" 0)))))
              (loop (if value? (cddr rest) (cdr rest))
                    (cons (list (substring token 1 n) (if value? (org-unquote next) "")
                                (if value? "true" "false")
                                (if value? (string-append token " " next) token)) out)))
            (loop (cdr rest) out)))))))
(def (org-option-kind key mode)
  (let (key (org-ascii-lower key))
    (if (string=? mode "radio")
      (cond ((string=? key "skip") "skip") ((string=? key "skipcols") "skipcols")
            ((string=? key "splice") "splice") ((member key '("fmt" "efmt")) "fmt") (else "other"))
      (cond ((member key '("dep" "deps")) "dep") ((member key '("transpose" "trans")) "transpose")
            ((member key '("title" "ind" "timeind" "type" "with" "file" "set" "min" "max")) key)
            (else "other")))))
