;;; Emit the host's labels and identities from Parser's grammar descriptor.
(import (only-in :gerbil-parser/language-support/grammar language-grammar-ir language-grammar-machine)
        (only-in :gerbil-parser/language-support/loader-identity descriptor-ref)
        (only-in :gerbil-parser/artifact-support parser-machine-grammar-digest))
(export generate-language-catalog)

(def (generate-language-catalog path descriptor)
  (def ir (language-grammar-ir descriptor))
  (def kinds (cdr (assq 'syntax-kinds ir)))
  (def root (cdr (assq 'root-kind ir)))
  (def root-index
    (let loop ((remaining kinds) (index 0))
      (cond ((null? remaining) (error "syntax root is absent" root))
            ((eq? root (caar remaining)) index)
            (else (loop (cdr remaining) (+ index 1))))))
  (call-with-output-file path
    (lambda (port)
      (display "// @generated from Parser grammar metadata.\nuse crate::org_product::{KindCategory, KindSpec, LanguageSpec};\n\n" port)
      (display "static KINDS: &[KindSpec] = &[\n" port)
      (for-each
       (lambda (row)
         (display "    KindSpec { name: " port)
         (write (symbol->string (car row)) port)
         (display ", category: KindCategory::" port)
         (display (case (cadr row)
                    ((node) "Node") ((token) "Token")
                    (else (error "unknown syntax kind category" row))) port)
         (display " },\n" port))
       kinds)
      (display "];\n\npub static LANGUAGE: LanguageSpec = LanguageSpec {\n" port)
      (for-each
       (lambda (name)
         (display "    " port) (display name port) (display ": " port)
         (write (descriptor-ref descriptor name) port)
         (display ",\n" port))
       '(language version contract))
      (display "    grammar_digest: " port)
      (write (parser-machine-grammar-digest (language-grammar-machine descriptor)) port)
      (display ",\n    case_insensitive: " port)
      (display (if (cdr (assq 'case-insensitive? ir)) "true" "false") port)
      (display ",\n    root_kind: " port)
      (display root-index port)
      (display ",\n    kinds: KINDS,\n};\n" port))))
