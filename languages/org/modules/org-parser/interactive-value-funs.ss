;;; -*- Gerbil -*-
;;; Pure inert Org Interactive choice grammar and semantic admission.
(import (only-in "text-funs.ss" org-trim org-prefix-at? org-find org-physical-lines)
        (only-in "property-token-funs.ss" org-trim-marks))
(export org-interactive-choice)
(def (split-value text delimiter)
  (let loop ((start 0) (out '()))
    (let* ((next (org-find text delimiter start))
           (part (substring text start (or next (string-length text)))))
      (if next (loop (+ next (string-length delimiter)) (cons part out))
        (reverse (cons part out))))))
(def (optional-value text)
  (let (value (org-trim text)) (if (member value '("" "-")) "" value)))
(def (org-interactive-choice body)
  (call/cc
   (lambda (return)
     (def (fail message) (return (list (list "error" message))))
     (def (required value field (cell? #f))
       (if (and value (not (string=? (org-trim value) ""))) value
         (fail (string-append (if cell? "agent-interactive detail row requires `" "agent-interactive choice requires `")
                              field "`"))))
     (def (entry line)
       (let (cells (map org-trim (split-value (org-trim-marks line '(#\|)) "|")))
         (cond ((equal? cells '("n" "id" "contract" "full" "use-if")) #f)
               ((not (= (length cells) 5))
                (fail (string-append "agent-interactive detail row must use `n|id|contract|full|use-if`: " line)))
               (else (list "entry" (required (list-ref cells 0) "n" #t)
                           (required (list-ref cells 1) "id" #t) (optional-value (list-ref cells 2))
                           (required (list-ref cells 3) "full" #t) (required (list-ref cells 4) "use-if" #t))))))
     (def (finish fields entries)
       (def (field key) (let (pair (assoc key fields)) (and pair (cadr pair))))
       (let* ((id (required (field "id") "id")) (method (required (field "method") "method")))
         (unless (string=? method "choice")
           (fail (string-append "agent-interactive `" id "` must use `method: choice`, got `" method "`")))
         (let* ((stage (required (field "stage") "stage")) (info (required (field "info") "info")))
           (when (null? entries)
             (fail (string-append "agent-interactive `" id "` details table must contain at least one row")))
           (let ((raw (required (field "categories") "categories")))
             (let loop ((parts (split-value raw ",")) (keys '()) (detail? #f) (categories '()))
               (if (null? parts)
                 (begin
                   (unless detail? (fail (string-append "agent-interactive `" id "` categories must include `?=detail`")))
                   (append
                    (list (list "choice" id method stage (optional-value (or (field "group") ""))
                                (optional-value (or (field "target") "")) (optional-value (or (field "create") "")) info))
                    (reverse categories) entries))
                 (let* ((part (car parts)) (split (org-find part "=")))
                   (unless split
                     (fail (string-append "agent-interactive `" id "` category `" part "` must use key=value")))
                   (let* ((key (org-trim (substring part 0 split)))
                          (value (org-trim (substring part (+ split 1) (string-length part))))
                          (is-detail? (and (string=? key "?") (string=? value "detail"))))
                     (when (or (string=? key "") (string=? value "") (member key keys))
                       (fail (string-append "agent-interactive `" id "` category keys and values must be non-empty and unique")))
                     (unless (or is-detail? (ormap (lambda (row) (and (string=? (cadr row) key) (string=? (caddr row) value))) entries))
                       (fail (string-append "agent-interactive `" id "` category `" key "=" value "` must match a detail row")))
                     (loop (cdr parts) (cons key keys) (or detail? is-detail?)
                           (cons (list "category" key value (if is-detail? "true" "false")) categories))))))))))
     (let loop ((lines (org-physical-lines body)) (fields '()) (details? #f) (entries '()))
       (if (null? lines) (finish fields (reverse entries))
         (let ((line (org-trim (caar lines))))
           (cond ((string=? line "") (loop (cdr lines) fields details? entries))
                 ((and details? (org-prefix-at? line "|" 0))
                  (let (row (entry line)) (loop (cdr lines) fields details? (if row (cons row entries) entries))))
                 ((string=? line "details:") (loop (cdr lines) fields #t entries))
                 (else
                  (let (split (org-find line ":"))
                    (loop (cdr lines)
                          (if split (cons (list (org-trim (substring line 0 split))
                                                (org-trim (substring line (+ split 1) (string-length line)))) fields) fields)
                          details? entries))))))))))
