;;; -*- Gerbil -*-
;;; Native agenda and timer source recognition; Rust admits typed time fields.
(import (only-in "duration-funs.ss" value-digit? value-digit-end value-two-digits))
(export org-headline-time org-timer-stamps)
(def (ascii-word? ch)
  (or (char<=? #\0 ch #\9) (char<=? #\a ch #\z) (char<=? #\A ch #\Z)))
(def (boundary? text index (timer? #f))
  (or (< index 0) (>= index (string-length text))
      (let (ch (string-ref text index))
        (and (not (ascii-word? ch)) (or (not timer?) (not (char=? ch #\:)))))))
(def (am-pm text start)
  (and (<= (+ start 2) (string-length text))
       (char-ci=? (string-ref text (+ start 1)) #\m)
       (let (first (char-downcase (string-ref text start)))
         (and (memv first '(#\a #\p)) first))))
(def (time-at text start)
  (let (end (string-length text))
    (and (< start end) (value-digit? (string-ref text start))
         (let* ((first (string-ref text start))
                (after (+ start 1))
                (two? (and (char<=? first #\2) (< after end)
                           (value-digit? (string-ref text after))))
                (hour (if two? (value-two-digits text start)
                          (- (char->integer first) 48)))
                (cursor (if two? (+ start 2) after))
                (colon? (and (< cursor end) (char=? (string-ref text cursor) #\:)))
                (minute (if colon? (value-two-digits text (+ cursor 1)) 0))
                (after-minute (if colon? (+ cursor 3) cursor))
                (marker (am-pm text after-minute))
                (next (if marker (+ after-minute 2) after-minute)))
           (and minute (<= minute 59) (or colon? marker) (boundary? text next)
                (list (cond ((and (eqv? marker #\a) (= hour 12)) 0)
                            ((and (eqv? marker #\p) (not (= hour 12))) (+ hour 12))
                            (else hour))
                      minute next))))))
(def (timestamp-start? text start)
  (and (< (+ start 1) (string-length text))
       (let ((ch (string-ref text start)) (next (string-ref text (+ start 1))))
         (or (and (char=? ch #\<) (or (value-digit? next) (char=? next #\%)))
             (and (char=? ch #\[) (value-digit? next))))))
(def (timestamp-after text start)
  (let ((closing (if (char=? (string-ref text start) #\<) #\> #\]))
        (end (string-length text)))
    (let loop ((i (+ start 1)))
      (cond ((= i end) (+ start 1))
            ((char=? (string-ref text i) closing) (+ i 1))
            (else (loop (+ i 1)))))))
(def (org-headline-time text)
  (let ((end (string-length text)))
    (let loop ((i 0))
      (cond ((= i end) '())
            ((timestamp-start? text i) (loop (timestamp-after text i)))
            (else
             (let (start (and (boundary? text (- i 1)) (time-at text i)))
               (if (not start) (loop (+ i 1))
                 (let* ((next (caddr start))
                        (range? (and (< next end) (char=? (string-ref text next) #\-)))
                        (range-start (and range? (+ next 1)))
                        (finish (and range?
                                     (time-at text
                                       (if (and (< range-start end)
                                                (char=? (string-ref text range-start) #\-))
                                         (+ range-start 1) range-start)))))
                   (list (map number->string
                              (append (list (car start) (cadr start))
                                      (if finish (list (car finish) (cadr finish)) '()))))))))))))
(def (timer-at text start)
  (let* ((end (string-length text))
         (signed? (and (< start end) (memv (string-ref text start) '(#\+ #\-))))
         (sign (if (and signed? (char=? (string-ref text start) #\-)) -1 1))
         (hour-start (if signed? (+ start 1) start))
         (hour-end (value-digit-end text hour-start))
         (minute-start (+ hour-end 1))
         (minutes (value-two-digits text minute-start))
         (seconds-start (+ minute-start 3))
         (seconds (value-two-digits text seconds-start))
         (next (+ seconds-start 2)))
    (and (> hour-end hour-start) (< hour-end end)
         (char=? (string-ref text hour-end) #\:)
         minutes seconds (<= minutes 59) (<= seconds 59)
         (< (+ minute-start 2) end) (char=? (string-ref text (+ minute-start 2)) #\:)
         (boundary? text next #t)
         (let* ((hours (string->number (substring text hour-start hour-end)))
                (total (* sign (+ (* hours 3600) (* minutes 60) seconds))))
           ;; Reject values that cannot be admitted to the public signed model.
           (and (<= hours 9223372036854775807)
                (<= -9223372036854775808 total 9223372036854775807)
                (list next (substring text start next) (number->string total)))))))
(def (org-timer-stamps text)
  (let ((end (string-length text)))
    (let loop ((i 0) (rows '()))
      (if (= i end) (reverse rows)
        (let (stamp (and (boundary? text (- i 1) #t) (timer-at text i)))
          (if stamp (loop (car stamp) (cons (cdr stamp) rows))
            (loop (+ i 1) rows)))))))
