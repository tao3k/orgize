;;; -*- Gerbil -*-
;;; Source-backed INCLUDE path, positional arguments, and header options.

(import (only-in "event-source-header.ss" event-source-header-forms))
(export event-include-initial event-include-forms)

(def event-include-initial
  '((include-option-start 0) (include-argument-start 0)
    (include-cursor 0) (include-quoted #f)))

(def include-index '(line-index include-byte-index))
(def include-next `(line-step ,include-index))
(def include-space? `(line-bytes-any-in? ,include-index ,include-next (9 32)))

(def (include-argument-forms from until)
  `((start-node OrgIncludeTail)
    (if (uint-positive? (state include-cursor)) ()
        ((set-uint include-cursor (offset ,from))))
    (for-line-bytes include-byte-index ,from ,until
      ((if (uint-positive? (state include-option-start))
           ()
           ((if (line-byte-equal? ,include-index 34)
                ((if (uint-equal? (state include-argument-start) (uint 0))
                     ((token IncludeTrivia (state-offset include-cursor)
                             ,include-index)
                      (set-uint include-argument-start (offset ,include-index))) ())
                 (set-bool include-quoted (not (state include-quoted))))
                ((if (state include-quoted) ()
                     ((if ,include-space?
                          ((if (uint-positive? (state include-argument-start))
                               ((token IncludeArgument
                                       (state-offset include-argument-start)
                                       ,include-index)
                                (set-uint include-cursor (offset ,include-index))
                                (set-uint include-argument-start (uint 0))) ()))
                          ((if (and (line-byte-equal? ,include-index 58)
                                    (uint-equal? (state include-argument-start)
                                                 (uint 0)))
                               ((token IncludeTrivia
                                       (state-offset include-cursor)
                                       ,include-index)
                                (set-uint include-option-start (offset ,include-index)))
                               ((if (uint-equal? (state include-argument-start)
                                                   (uint 0))
                                    ((token IncludeTrivia
                                            (state-offset include-cursor)
                                            ,include-index)
                                     (set-uint include-argument-start
                                               (offset ,include-index))) ())))))))))))))
    (if (uint-positive? (state include-option-start))
        ((if (uint-positive? (state include-argument-start))
             ((token IncludeArgument (state-offset include-argument-start)
                     (state-offset include-option-start))) ())
         ,@(event-source-header-forms '(state-offset include-option-start)
                                     until until))
        ((if (uint-positive? (state include-argument-start))
             ((token IncludeArgument (state-offset include-argument-start)
                     ,until))
             ((token IncludeTrivia (state-offset include-cursor) ,until)))))
    (finish-node)))

(def (event-include-forms from until)
  (let* ((quoted-start `(line-step ,from))
         (quoted-end `(line-scan-until ,quoted-start "\""))
         (quoted-tail `(line-step ,quoted-end))
         (bare-end `(line-scan-word ,from)))
    `((start-node OrgKeywordInclude)
      (if (offset-less? ,from ,until)
          ((if (line-byte-equal? ,from 34)
               ((start-node OrgIncludePath)
                (if (offset-less? ,quoted-end ,until)
                    ((token IncludePathDelimiter ,from ,quoted-start)
                     (token IncludePathValue ,quoted-start ,quoted-end)
                     (token IncludePathDelimiter ,quoted-end ,quoted-tail))
                    ((token IncludePathUnclosed ,from ,until)))
                (finish-node)
                (if (offset-less? ,quoted-end ,until)
                    ,(include-argument-forms quoted-tail until) ()))
               ((start-node OrgIncludePath)
                (token IncludePathValue ,from ,bare-end)
                (finish-node)
                ,@(include-argument-forms bare-end until)))) ())
      (finish-node))))
