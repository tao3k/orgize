;;; -*- Gerbil -*-
;;; Org v1 grammar. Contextual structure is declared in parser.ss.

(import (only-in :gerbil-parser/language-support/grammar deflanguage)
        (only-in :gerbil-parser/src/language/descriptor language-grammar-with-identity))
(export org-mode-language-grammar)

(deflanguage org-mode
  (syntax
   (lexical
    (root org-file)
    (lex
     (headline HeadlineLine (literals "*"))
     (block-begin BlockBeginLine (literals "#+begin_src"))
     (block-end BlockEndLine (literals "#+end_src"))
     (text TextLine (fallback)))
    (extras)
    (keywords)
    (recoveries)
    (conflicts reject)
    (case-insensitive #t)
    (catalog
  (syntax-kinds
   (OrgFile node (element))
   (OrgHeadline node (line title))
   (OrgHeadlineTitle node (object))
   (OrgKeywordValue node (object))
   (OrgKeywordAttributes node (attribute))
   (OrgKeywordInclude node (path argument option))
   (OrgIncludePath node (value))
   (OrgIncludeTail node (argument option))
   (OrgKeywordRawValue node (value))
   (OrgLinkDescription node (object))
   (OrgSourceBlock node (begin language body end))
   (OrgBlockBodyLine node (body))
   (OrgDynamicBlock node (begin name element end))
   (OrgSpecialBlock node (begin name element end))
   (OrgLatexEnvironment node (begin name body end))
   (OrgQuoteBlock node (begin body end))
   (OrgExampleBlock node (begin body end))
   (OrgVerseBlock node (begin body end))
   (OrgCenterBlock node (begin body end))
   (OrgCommentBlock node (begin body end))
   (OrgExportBlock node (begin backend body end))
   (OrgPropertyDrawer node (begin property end))
   (OrgDrawer node (begin name element end))
   (OrgNodeProperty node (key value))
   (OrgTextLine node (line))
   (OrgParagraph node (line))
   (OrgFootnoteDefinition node (label element))
   (OrgComment node (line))
   (OrgDiarySexp node (line))
   (OrgHorizontalRule node (line))
   (OrgFixedWidth node (line))
   (OrgKeyword node (key value))
   (OrgBabelCall node (key value))
   (OrgPlanning node (key value))
   (OrgPlanningValue node (timestamp text))
   (OrgClock node (key value))
   (OrgClockValue node (timestamp duration text))
   (OrgPlainList node (item))
   (OrgListItem node (bullet element))
   (OrgTable node (row))
   (OrgTableEl node (line))
   (OrgTableRow node (cell))
   (OrgTableRuleRow node (line))
   (OrgTableCell node (text))
   (OrgTableFormulaValue node (assignment))
   (OrgTableFormulaAssignment node (lhs rhs flag))
   (OrgTableFormulaLhs node (reference))
   (OrgTableFormulaRhs node (reference))
   (OrgTableFormulaReference node (value))
   (OrgLink node (target description))
   (OrgTarget node (value))
   (OrgRadioTarget node (value))
   (OrgStatisticsCookie node (value))
   (OrgLineBreak node (text))
   (OrgExportSnippet node (backend value))
   (OrgFootnoteReference node (label definition))
   (OrgInlineSourceBlock node (language parameters value))
   (OrgInlineBabelCall node (call inside-header arguments end-header))
   (OrgMacro node (name arguments))
   (OrgCitation node (global-prefix reference global-suffix))
   (OrgCitationReference node (prefix key suffix))
   (OrgCitationMalformedReference node (text))
   (OrgCitationGlobalPrefix node (object))
   (OrgCitationGlobalSuffix node (object))
   (OrgCitationReferencePrefix node (object))
   (OrgCitationReferenceSuffix node (object))
   (CitationGlobalPrefixContent node (object))
   (CitationGlobalSuffixContent node (object))
   (CitationReferencePrefixContent node (object))
   (CitationReferenceSuffixContent node (object))
   (OrgTimestampActive node (point range))
   (OrgTimestampInactive node (point range))
   (OrgTimestampDiary node (expression time))
   (OrgTimestampPoint node (date day-name time repeater delay))
   (OrgEntity node (name post))
   (OrgLaTeXFragment node (value))
   (OrgCode node (value))
   (OrgVerbatim node (value))
   (OrgBold node (value))
   (OrgItalic node (value))
   (OrgUnderline node (value))
   (OrgSubscript node (value))
   (OrgSuperscript node (value))
   (OrgStrikeThrough node (value))
   (OrgSection node (heading element))
   (OrgSourceHeaderArgs node (key value))
   (HeadlineLine token (text))
   (HeadlineTitle token (text))
   (HeadlineTagValue token (text))
   (HeadlineTagTrivia token (text))
   (HeadlineTrivia token (text))
   (BlockBeginLine token (text))
   (SourceLanguage token (text))
   (DynamicBlockName token (text))
   (SpecialBlockName token (text))
   (LatexEnvironmentBegin token (text))
   (LatexEnvironmentName token (text))
   (LatexEnvironmentBeginSuffix token (text))
   (LatexEnvironmentBody token (text))
   (LatexEnvironmentEnd token (text))
   (DynamicBlockHeaderTrivia token (text))
   (ExportBackend token (text))
   (BlockHeaderTrivia token (text))
   (SourceHeaderKey token (text))
   (SourceHeaderValue node (value))
   (SourceHeaderTrivia token (text))
   (SourceSwitchName token (text))
   (SourceSwitchValue node (value))
   (BlockEndLine token (text))
   (TextLine token (text))
   (BlockEscape token (text))
   (CommentLine token (text))
   (DiarySexpValue token (text))
   (DiarySexpTrivia token (text))
   (HorizontalRuleLine token (text))
   (FixedWidthPrefix token (text))
   (FixedWidthValue token (text))
   (DrawerBeginLine token (text))
   (DrawerName token (text))
   (DrawerTrivia token (text))
   (DrawerEndLine token (text))
   (PropertyKey token (text))
   (PropertyValue token (text))
   (PropertyTrivia token (text))
   (LinkTarget token (text))
   (LinkDescription token (text))
   (LinkTrivia token (text))
   (InlineTargetDelimiter token (text))
   (InlineTargetValue token (text))
   (StatisticsCookieValue token (text))
   (LineBreakText token (text))
   (ExportSnippetBackend token (text))
   (ExportSnippetValue token (text))
   (ExportSnippetDelimiter token (text))
   (FootnoteReferenceDelimiter token (text))
   (FootnoteReferenceLabel token (text))
   (FootnoteReferenceDefinition token (text))
   (FootnoteDefinitionDelimiter token (text))
   (FootnoteDefinitionLabel token (text))
   (InlineCodeDelimiter token (text))
   (InlineSourceLanguage token (text))
   (InlineSourceParameters token (text))
   (InlineSourceBody token (text))
   (InlineBabelCallName token (text))
   (InlineBabelInsideHeader token (text))
   (InlineBabelArguments token (text))
   (InlineBabelEndHeader token (text))
   (MacroDelimiter token (text))
   (MacroName token (text))
   (MacroArguments node (argument))
   (OrgCitationHead node (style variant))
   (CitationDelimiter token (text))
   (CitationStyle token (text))
   (CitationVariant token (text))
   (CitationGlobalPrefix token (text))
   (CitationGlobalSuffix token (text))
   (CitationSeparator token (text))
   (CitationReferencePrefix token (text))
   (CitationReferenceMarker token (text))
   (CitationReferenceKey token (text))
   (CitationMalformedSegment token (text))
   (CitationReferenceSuffix token (text))
   (TimestampDelimiter token (text))
   (TimestampDate node (year month day))
   (TimestampYear token (text))
   (TimestampMonth token (text))
   (TimestampDay token (text))
   (TimestampDateSeparator token (text))
   (TimestampDayName token (text))
   (TimestampTime node (hour minute end))
   (TimestampRepeater node (mark value unit))
   (TimestampDelay node (mark value unit))
   (TimestampRepeaterMark token (text))
   (TimestampRepeaterValue token (text))
   (TimestampRepeaterUnit token (text))
   (TimestampDelayMark token (text))
   (TimestampDelayValue token (text))
   (TimestampDelayUnit token (text))
   (TimestampRangeSeparator token (text))
   (TimestampDiaryExpression token (text))
   (TimestampTrivia token (text))
   (EntityDelimiter token (text))
   (EntityName token (text))
   (EntityPost token (text))
   (LatexFragmentValue token (text))
   (InlineMarkupDelimiter token (text))
   (InlineMarkupValue token (text))
   (InlineScriptDelimiter token (text))
   (InlineScriptValue token (text))
   (TableSeparator token (text))
   (TableCellText token (text))
   (TableTrivia token (text))
   (TableRuleText token (text))
   (TableElLine token (text))
   (FormulaTrivia token (text))
   (FormulaSeparator token (text))
   (FormulaEquals token (text))
   (FormulaFlagSeparator token (text))
   (FormulaFlag token (text))
   (FormulaText token (text))
   (FormulaFieldReference token (text))
   (FormulaRowReference token (text))
   (FormulaRemoteReference token (text))
   (ListBullet token (text))
   (ListCounterValue token (text))
   (ListCheckboxValue token (text))
   (ListTagValue token (text))
   (ListTrivia token (text))
   (KeywordKey token (text))
   (KeywordOptional token (text))
   (KeywordValue token (text))
   (KeywordTrivia token (text))
   (IncludePathDelimiter token (text))
   (IncludePathValue token (text))
   (IncludePathUnclosed token (text))
   (IncludeArgument token (text))
   (IncludeTrivia token (text))
   (PlanningKey token (text))
   (PlanningValue token (text))
   (PlanningTrivia token (text))
   (ClockKey token (text))
   (ClockValue token (text))
   (ClockDuration token (text))
   (ClockTrivia token (text))
   (OrgInlinetask node (heading element end))
   (OrgInlinetaskEnd node (line))
   (InlinetaskEndLine token (text))
   (OrgCloze node (text hint id))
   (ClozeDelimiter token (text))
   (ClozeText token (text))
   (ClozeHint token (text))
   (ClozeId token (text))
   (OrgTagVocabulary node (definition group))
   (OrgTagExclusiveGroup node (definition group))
   (OrgTagInclusiveGroup node (definition group))
   (TagName token (text))
   (TagShortcut token (text))
   (TagShortcutOpen token (text))
   (TagShortcutClose token (text))
   (TagGroupOpen token (text))
   (TagGroupClose token (text))
   (TagGroupSeparator token (text))
   (TagTrivia token (text))
   (BabelCallName token (text))
   ;; Append fragment nodes so existing native syntax-kind IDs remain stable.
   (OrgFootnoteInlineDefinition node (object))
   (OrgClozeText node (object))
   (TimestampHour token (text))
   (TimestampMinute token (text))
   (TimestampEndHour token (text))
   (TimestampEndMinute token (text))
   (TimestampTimeSeparator token (text))
   (TimestampTimeRangeSeparator token (text))
   (TimestampTimeText token (text))
   (TimestampTimeEnd node (hour minute))
   (TimestampSecondYear token (text))
   (TimestampSecondMonth token (text))
   (TimestampSecondDay token (text))
   (TimestampSecondHour token (text))
   (TimestampSecondMinute token (text))
   (TimestampSecondTime node (hour minute end))
   (TimestampSecondDayName token (text))
   (SourceSwitchText token (text))
   (SourceSwitchQuote token (text))
   (SourceSwitchNewLineNumber token (text))
   (SourceSwitchContinuedLineNumber token (text))
   (SourceSwitchLabelFormat node (value))
   (SourceHeaderColon token (text))
   (SourceHeaderParameters node (argument))
   (SourceHeaderArgument node (key value))
   (SourceHeaderArgumentValue node (value))
   (SourceHeaderValueContent node (text))
   (SourceHeaderText token (text))
   (SourceHeaderQuote token (text))
   (TableCellContent node (object))
   (FormulaContent node (text))
   (MacroDefinitionContent node (name template))
   (MacroDefinitionTemplate node (text))
   (MacroDefinitionName token (text))
   (MacroDefinitionInvalid token (text))
   (MacroTemplateText token (text))
   (MacroArgumentContent node (argument))
   (OrgMacroArgument node (text))
   (MacroArgumentText token (text))
   (MacroTrivia token (text))
   (FormulaFlagContent node (text)))
  (terminals
   (headline HeadlineLine)
   (block-begin BlockBeginLine)
   (block-end BlockEndLine)
   (text TextLine))
  (reserved-token-kinds
   HeadlineTitle HeadlineTagValue HeadlineTagTrivia HeadlineTrivia
   SourceLanguage DynamicBlockName SpecialBlockName LatexEnvironmentBegin
   LatexEnvironmentName LatexEnvironmentBeginSuffix LatexEnvironmentBody LatexEnvironmentEnd
   DynamicBlockHeaderTrivia ExportBackend BlockHeaderTrivia SourceHeaderKey
   SourceHeaderTrivia SourceSwitchName BlockEscape CommentLine
   DiarySexpValue DiarySexpTrivia HorizontalRuleLine FixedWidthPrefix
   FixedWidthValue DrawerBeginLine DrawerName DrawerTrivia
   DrawerEndLine PropertyKey PropertyValue PropertyTrivia
   LinkTarget LinkDescription LinkTrivia InlineTargetDelimiter
   InlineTargetValue StatisticsCookieValue LineBreakText ExportSnippetBackend
   ExportSnippetValue ExportSnippetDelimiter FootnoteReferenceDelimiter FootnoteReferenceLabel
   FootnoteReferenceDefinition FootnoteDefinitionDelimiter FootnoteDefinitionLabel InlineCodeDelimiter
   InlineSourceLanguage InlineSourceParameters InlineSourceBody InlineBabelCallName
   InlineBabelInsideHeader InlineBabelArguments InlineBabelEndHeader MacroDelimiter
   MacroName CitationDelimiter CitationStyle CitationVariant
   CitationGlobalPrefix CitationGlobalSuffix CitationSeparator CitationReferencePrefix
   CitationReferenceMarker CitationReferenceKey CitationMalformedSegment CitationReferenceSuffix
   TimestampDelimiter TimestampYear TimestampMonth TimestampDay
   TimestampDateSeparator TimestampDayName TimestampRepeaterMark TimestampRepeaterValue
   TimestampRepeaterUnit TimestampDelayMark TimestampDelayValue TimestampDelayUnit
   TimestampRangeSeparator TimestampDiaryExpression TimestampTrivia EntityDelimiter
   EntityName EntityPost LatexFragmentValue InlineMarkupDelimiter
   InlineMarkupValue InlineScriptDelimiter InlineScriptValue TableSeparator
   TableCellText TableTrivia TableRuleText TableElLine
   FormulaTrivia FormulaSeparator FormulaEquals FormulaFlagSeparator
   FormulaFlag FormulaText FormulaFieldReference FormulaRowReference
   FormulaRemoteReference ListBullet ListCounterValue ListCheckboxValue
   ListTagValue ListTrivia KeywordKey KeywordOptional
   KeywordValue KeywordTrivia IncludePathDelimiter IncludePathValue
   IncludePathUnclosed IncludeArgument IncludeTrivia PlanningKey
   PlanningValue PlanningTrivia ClockKey ClockValue
   ClockDuration ClockTrivia InlinetaskEndLine ClozeDelimiter
   ClozeText ClozeHint ClozeId TagName
   TagShortcut TagShortcutOpen TagShortcutClose TagGroupOpen
   TagGroupClose TagGroupSeparator TagTrivia BabelCallName
   TimestampHour TimestampMinute TimestampEndHour TimestampEndMinute
   TimestampTimeSeparator TimestampTimeRangeSeparator TimestampTimeText TimestampSecondYear
   TimestampSecondMonth TimestampSecondDay TimestampSecondHour TimestampSecondMinute
   TimestampSecondDayName SourceSwitchText SourceSwitchQuote SourceSwitchNewLineNumber
   SourceSwitchContinuedLineNumber SourceHeaderColon SourceHeaderText SourceHeaderQuote
   MacroDefinitionName MacroDefinitionInvalid MacroTemplateText MacroArgumentText
   MacroTrivia))))
  (rules
   (org-file
    (node OrgFile
      (repeat (field element (reference org-element)))))
   (org-element
    (choice (reference source-block)
            (reference headline)
            (reference text-line)))
   (source-block
    (node OrgSourceBlock
      (seq (field begin (token block-begin))
           (repeat (field body (token text)))
           (field end (token block-end)))))
   (headline
    (node OrgHeadline (field line (token headline))))
   (text-line
    (node OrgTextLine (field line (token text))))))

(def org-mode-language-grammar
  (language-grammar-with-identity org-mode-syntax "org-mode" "v1" "org-elements.v1"))
