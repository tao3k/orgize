;;; -*- Gerbil -*-
;;; Pure DIR marker recognition. Environment/process effects remain host-owned.
(import "text-funs.ss")
(export org-dir-command-plan org-dir-environment-plan)

(def (command-end text start)
  (and (org-prefix-at? text "$(" start)
       (let ((end (string-length text)))
         (let loop ((index (+ start 2)) (depth 1) (single? #f) (double? #f) (escaped? #f))
           (and (< index end)
                (let (ch (string-ref text index))
                  (cond
                   (escaped? (loop (+ index 1) depth single? double? #f))
                   ((and (char=? ch #\\) (not single?)) (loop (+ index 1) depth single? double? #t))
                   ((and (char=? ch #\') (not double?)) (loop (+ index 1) depth (not single?) double? #f))
                   ((and (char=? ch #\") (not single?)) (loop (+ index 1) depth single? (not double?) #f))
                   ((or single? double?) (loop (+ index 1) depth single? double? #f))
                   ((char=? ch #\() (loop (+ index 1) (+ depth 1) #f #f #f))
                   ((char=? ch #\)) (if (= depth 1) (+ index 1) (loop (+ index 1) (- depth 1) #f #f #f)))
                   (else (loop (+ index 1) depth #f #f #f)))))))))

(def (environment-end text start)
  (and (org-prefix-at? text "$" start)
       (let ((from (+ start 1)) (end (string-length text)))
         (if (org-prefix-at? text "{" from)
           (let (close (org-find text "}" (+ from 1))) (and close (+ close 1)))
           (let loop ((index from))
             (if (and (< index end)
                      (let (ch (string-ref text index))
                        (or (char<=? #\a ch #\z) (char<=? #\A ch #\Z) (char<=? #\0 ch #\9)
                            (memv ch '(#\_ #\- #\.)))))
               (loop (+ index 1)) (and (> index from) index)))))))

(def (marker-plan source command?)
  (let* ((text source) (end (string-length text)))
    (let loop ((index 0) (literal 0) (rows '()))
      (if (= index end)
        (reverse (if (< literal end) (cons (list "literal" (substring text literal end) "") rows) rows))
        (let (stop (if command? (command-end text index) (environment-end text index)))
          (if stop
            (let* ((original (substring text index stop))
                   (from (+ index (if (or command? (org-prefix-at? text "${" index)) 2 1)))
                   (until (- stop (if (or command? (org-prefix-at? text "${" index)) 1 0)))
                   (value (substring text from until))
                   (before (if (< literal index) (cons (list "literal" (substring text literal index) "") rows) rows)))
              (loop stop stop (cons (list (if command? "command" "environment") value original) before)))
            (loop (+ index 1) literal rows)))))))

(def (org-dir-command-plan text) (marker-plan text #t))
(def (org-dir-environment-plan text) (marker-plan text #f))
