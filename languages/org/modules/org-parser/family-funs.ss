;;; -*- Gerbil -*-
;;; Closed private value admission. Scheme executes the existing pure owners.
(import "../org-elements/headline-properties.ss"
        "../org-elements/link-properties.ss"
        "../org-elements/logbook-properties.ss"
        "../org-elements/table-properties.ss"
        "../org-elements/affiliated-properties.ss")
(import (only-in "text-funs.ss" org-physical-lines org-trim)
        (only-in "keyword-funs.ss" org-keyword-facts))
(export org-family-call org-document-batch org-link-batch org-affiliation-batch org-logbook-batch org-table-batch)

(def (take-fields count fields)
  (let loop ((n count) (rest fields) (out '()))
    (if (= n 0) (values (reverse out) rest)
      (if (null? rest) (error "truncated native family fields")
        (loop (- n 1) (cdr rest) (cons (car rest) out))))))

(def (read-args types fields)
  (let loop ((types types) (rest fields) (args '()))
    (if (null? types) (values (reverse args) rest)
      (begin
        (when (null? rest) (error "missing native family argument"))
        (cond
         ((string=? (car types) "list")
          (let (count (string->number (car rest)))
            (unless (and (exact-integer? count) (<= 0 count)) (error "invalid native list count"))
            (let-values (((items next) (take-fields count (cdr rest))))
              (loop (cdr types) next (cons items args)))))
         ((string=? (car types) "bool")
          (unless (member (car rest) '("true" "false")) (error "invalid native boolean"))
          (loop (cdr types) (cdr rest) (cons (string=? (car rest) "true") args)))
         (else (loop (cdr types) (cdr rest) (cons (car rest) args))))))))

(def (project value)
  (cond ((boolean? value) (list (if value "true" "false")))
        ((string? value) (list value))
        ((and (list? value) (andmap string? value)) value)
        (else (error "invalid native family result"))))

;; Display titles arrive from the admitted object projection in traversal
;; order. Explicit IDs are excluded; empty slugs never consume a suffix.
(def (headline-document-anchors titles)
  (let (counts (make-hash-table))
    (map (lambda (title)
           (let (slug (headline-anchor-slug title))
             (if (string=? slug "") ""
               (let (count (or (hash-get counts slug) 0))
                 (hash-put! counts slug (+ count 1))
                 (if (= count 0) slug
                   (string-append slug "-" (number->string count)))))))
         titles)))

(def (org-family-call fields)
  (when (null? fields) (error "missing native family name"))
  (let* ((name (car fields))
         (types (cond
      ((string=? name "todo-directive?") '("text"))
      ((string=? name "todo-word-name") '("text"))
      ((string=? name "todo-open-words") '("text"))
      ((string=? name "todo-done-words") '("text"))
      ((string=? name "todo-state-from-directives") '("text" "list" "list" "list"))
      ((string=? name "todo-keyword-from-directives") '("text" "list" "list" "list"))
      ((string=? name "headline-content-after-todo") '("text" "list" "list" "list"))
      ((string=? name "headline-source-title") '("text" "text"))
      ((string=? name "planning-key-kind") '("text"))
      ((string=? name "priority-token?") '("text"))
      ((string=? name "headline-priority-cookie") '("text"))
      ((string=? name "headline-display-title") '("text" "bool"))
      ((string=? name "headline-anchor-slug") '("text"))
      ((string=? name "headline-document-anchors") '("list"))
      ((string=? name "headline-comment?") '("text"))
      ((string=? name "todo-keyword-matches?") '("text" "list" "list" "list" "text"))
      ((string=? name "memory-headline-state") '("text" "bool" "bool" "bool"))
      ((string=? name "org-image-link?") '("text"))
      ((string=? name "org-link-kind") '("text"))
      ((string=? name "org-link-protocol") '("text"))
      ((string=? name "org-link-target-key") '("text"))
      ((string=? name "org-link-protocol-path") '("text"))
      ((string=? name "org-link-file-path") '("text"))
      ((string=? name "org-link-attachment-path") '("text"))
      ((string=? name "org-link-search") '("text"))
      ((string=? name "org-link-file-path-kind") '("text"))
      ((string=? name "org-link-search-kind") '("text"))
      ((string=? name "org-link-search-value") '("text"))
      ((string=? name "org-expand-link-abbreviation") '("text" "text" "text"))
      ((string=? name "logbook-content-line") '("text"))
      ((string=? name "logbook-state-quote-shape") '("text"))
      ((string=? name "logbook-state-to") '("text"))
      ((string=? name "logbook-state-from") '("text"))
      ((string=? name "logbook-clock-duration-shape") '("text"))
      ((string=? name "logbook-clock-duration-value") '("text"))
      ((string=? name "table-column-cookie-match?") '("text" "text"))
      ((string=? name "table-column-cookie-kind") '("text"))
      ((string=? name "org-affiliated-keyword?") '("text" "list"))
      ((string=? name "logbook-line-kind") '("text"))
                  (else (error "unknown native family operation" name)))))
    (let-values (((args rest) (read-args types (cdr fields))))
      (unless (null? rest) (error "trailing native family fields"))
      (list (cond
      ((string=? name "todo-directive?") (project (todo-directive? (list-ref args 0))))
      ((string=? name "todo-word-name") (project (todo-word-name (list-ref args 0))))
      ((string=? name "todo-open-words") (project (todo-open-words (list-ref args 0))))
      ((string=? name "todo-done-words") (project (todo-done-words (list-ref args 0))))
      ((string=? name "todo-state-from-directives") (project (todo-state-from-directives (list-ref args 0) (list-ref args 1) (list-ref args 2) (list-ref args 3))))
      ((string=? name "todo-keyword-from-directives") (project (todo-keyword-from-directives (list-ref args 0) (list-ref args 1) (list-ref args 2) (list-ref args 3))))
      ((string=? name "headline-content-after-todo") (project (headline-content-after-todo (list-ref args 0) (list-ref args 1) (list-ref args 2) (list-ref args 3))))
      ((string=? name "headline-source-title") (project (headline-source-title (list-ref args 0) (list-ref args 1))))
      ((string=? name "planning-key-kind") (project (planning-key-kind (list-ref args 0))))
      ((string=? name "priority-token?") (project (priority-token? (list-ref args 0))))
      ((string=? name "headline-priority-cookie") (project (headline-priority-cookie (list-ref args 0))))
      ((string=? name "headline-display-title") (project (headline-display-title (list-ref args 0) (list-ref args 1))))
      ((string=? name "headline-anchor-slug") (project (headline-anchor-slug (list-ref args 0))))
      ((string=? name "headline-document-anchors") (project (headline-document-anchors (list-ref args 0))))
      ((string=? name "headline-comment?") (project (headline-comment? (list-ref args 0))))
      ((string=? name "todo-keyword-matches?") (project (todo-keyword-matches? (list-ref args 0) (list-ref args 1) (list-ref args 2) (list-ref args 3) (list-ref args 4))))
      ((string=? name "memory-headline-state") (project (memory-headline-state (list-ref args 0) (list-ref args 1) (list-ref args 2) (list-ref args 3))))
      ((string=? name "org-image-link?") (project (org-image-link? (list-ref args 0))))
      ((string=? name "org-link-kind") (project (org-link-kind (list-ref args 0))))
      ((string=? name "org-link-protocol") (project (org-link-protocol (list-ref args 0))))
      ((string=? name "org-link-target-key") (project (org-link-target-key (list-ref args 0))))
      ((string=? name "org-link-protocol-path") (project (org-link-protocol-path (list-ref args 0))))
      ((string=? name "org-link-file-path") (project (org-link-file-path (list-ref args 0))))
      ((string=? name "org-link-attachment-path") (project (org-link-attachment-path (list-ref args 0))))
      ((string=? name "org-link-search") (project (org-link-search (list-ref args 0))))
      ((string=? name "org-link-file-path-kind") (project (org-link-file-path-kind (list-ref args 0))))
      ((string=? name "org-link-search-kind") (project (org-link-search-kind (list-ref args 0))))
      ((string=? name "org-link-search-value") (project (org-link-search-value (list-ref args 0))))
      ((string=? name "org-expand-link-abbreviation") (project (org-expand-link-abbreviation (list-ref args 0) (list-ref args 1) (list-ref args 2))))
      ((string=? name "logbook-content-line") (project (logbook-content-line (list-ref args 0))))
      ((string=? name "logbook-state-quote-shape") (project (logbook-state-quote-shape (list-ref args 0))))
      ((string=? name "logbook-state-to") (project (logbook-state-to (list-ref args 0))))
      ((string=? name "logbook-state-from") (project (logbook-state-from (list-ref args 0))))
      ((string=? name "logbook-clock-duration-shape") (project (logbook-clock-duration-shape (list-ref args 0))))
      ((string=? name "logbook-clock-duration-value") (project (logbook-clock-duration-value (list-ref args 0))))
      ((string=? name "table-column-cookie-match?") (project (table-column-cookie-match? (list-ref args 0) (list-ref args 1))))
      ((string=? name "table-column-cookie-kind") (project (table-column-cookie-kind (list-ref args 0))))
      ((string=? name "org-affiliated-keyword?") (project (org-affiliated-keyword? (list-ref args 0) (list-ref args 1))))
      ((string=? name "logbook-line-kind") (project (logbook-line-kind (list-ref args 0))))
              (else (error "unknown native family operation" name)))))))

;; One native request owns headline values and keyword facts together. Facts
;; retain input order; the host binds that order to its source-backed records.
(def (org-document-batch fields)
  (let-values (((args rest) (read-args '("list" "list" "list" "list") fields)))
    (unless (null? rest) (error "trailing headline fields"))
    (let* ((configured-open (car args)) (configured-done (cadr args))
           (keywords (caddr args)) (titles (cadddr args))
           (directives
            (let loop ((rest keywords) (out '()))
              (cond ((null? rest) (reverse out))
                    ((null? (cdr rest)) (error "odd keyword fields"))
                    (else (loop (cddr rest)
                                (if (todo-directive? (car rest)) (cons (cadr rest) out) out))))))
           (open (if (null? directives) configured-open
                   (filter (lambda (word) (not (string=? word "")))
                           (foldr (lambda (directive out) (append (todo-open-words directive) out)) '() directives))))
           (done (if (null? directives) configured-done
                   (filter (lambda (word) (not (string=? word "")))
                           (foldr (lambda (directive out) (append (todo-done-words directive) out)) '() directives)))))
      (append
       (cons (append (list (number->string (length open)) (number->string (length done))) open done)
            (let loop ((rest titles) (out '()))
              (if (null? rest) (reverse out)
                (begin
                  (unless (and (pair? (cdr rest)) (pair? (cddr rest))
                               (member (caddr rest) '("true" "false")))
                    (error "invalid native headline fields"))
                  (let* ((title (car rest)) (body (cadr rest))
                         (state (todo-state-from-directives title directives configured-open configured-done))
                         (keyword (if (string=? state "") "" (todo-keyword-from-directives title directives configured-open configured-done)))
                         (after (headline-content-after-todo title directives configured-open configured-done))
                         (display (headline-display-title after (string=? (caddr rest) "true"))))
                    (loop (cdddr rest)
                          (cons (list state keyword after (headline-priority-cookie after) display
                                      (headline-source-title body keyword)
                                      (if (headline-comment? display) "true" "false")) out)))))))
       (let loop ((rest keywords) (index 0) (out '()))
         (if (null? rest) (reverse out)
           (let (facts (org-keyword-facts (car rest) (cadr rest)))
             (loop (cddr rest) (+ index 1)
                   (foldl cons
                          (cons (list "keyword" (number->string index)
                                      (number->string (length facts))) out)
                          facts)))))))))

(def (org-link-batch fields)
  (map (lambda (path)
         (let* ((file (org-link-file-path path)) (search (org-link-search path))
                (kind (org-link-search-kind search)) (value (org-link-search-value search)))
           (list (org-link-kind path) (org-link-target-key path) (org-link-protocol path)
                 (org-link-protocol-path path) file (org-link-attachment-path path)
                 (org-link-file-path-kind file) search kind value))) fields))

(def (org-affiliation-batch fields)
  (let-values (((args rest) (read-args '("list" "list") fields)))
    (unless (null? rest) (error "trailing native affiliation fields"))
    (map (lambda (key) (project (org-affiliated-keyword? key (car args)))) (cadr args))))

;; One drawer request, including source physical-line ranges and raw text.
(def (org-logbook-batch fields)
  (unless (= (length fields) 1) (error "invalid logbook fields"))
  (map (lambda (line)
         (let* ((raw (car line)) (content (logbook-content-line raw)))
           (list (number->string (caddr line)) (number->string (cadddr line)) raw content
                 (if (string=? (org-trim raw) "") "" (logbook-line-kind content))
                 (logbook-state-quote-shape content) (logbook-state-to content) (logbook-state-from content)
                 (logbook-clock-duration-shape content) (logbook-clock-duration-value content))))
       (org-physical-lines (car fields))))

(def (org-table-batch fields)
  (map (lambda (cell) (project (table-column-cookie-kind cell))) fields))
