;;; -*- Gerbil -*-
;;; Native absolute clocktable window grammar and calendar interval decisions.
(import (only-in "text-funs.ss" org-trim org-find)
        (only-in "property-token-funs.ss" org-parameter-text org-trim-marks
                 org-value-words org-unsigned-value)
        (only-in "duration-funs.ss" value-digit-end))
(export org-clock-bound org-clock-window org-calendar-date)
(def (org-calendar-date text)
  (let split ((start 0) (parts '()))
    (let* ((next (org-find text "-" start)) (raw (substring text start (or next (string-length text))))
           (value (and (string=? raw (org-trim raw)) (org-unsigned-value raw 65535)))
           (parts (cons value parts)))
      (if next (split (+ next 1) parts)
        (and (= (length parts) 3)
             (apply date-value (reverse parts)))))))
(def (month-days year month)
  (case month ((1 3 5 7 8 10 12) 31) ((4 6 9 11) 30)
    ((2) (if (or (= (modulo year 400) 0)
                  (and (= (modulo year 4) 0) (not (= (modulo year 100) 0)))) 29 28))
    (else 0)))
(def (date-value year month day (hour 0) (minute 0))
  (and year month day (<= 0 year 65535) (<= 1 month 12)
       (<= 1 day (month-days year month)) (<= 0 hour 23) (<= 0 minute 59)
       (list year month day hour minute)))
(def (day-number date)
  (let* ((month (cadr date)) (year (- (car date) (if (<= month 2) 1 0)))
         (era (floor (/ year 400))) (yoe (- year (* era 400)))
         (mp (+ month (if (> month 2) -3 9)))
         (doy (+ (quotient (+ (* 153 mp) 2) 5) (caddr date) -1)))
    (+ (* era 146097) (* yoe 365) (quotient yoe 4) (- (quotient yoe 100)) doy -719468)))
(def (bound-row date)
  (map number->string (append date (list (+ (* (day-number date) 1440)
                                           (* (list-ref date 3) 60) (list-ref date 4))))))
(def (day-shift date count)
  (and date
       (let loop ((year (car date)) (month (cadr date)) (day (+ (caddr date) count)))
         (cond ((< day 1)
                (let* ((m (if (= month 1) 12 (- month 1)))
                       (y (if (= month 1) (- year 1) year)))
                  (and (>= y 0) (loop y m (+ day (month-days y m))))))
               ((> day (month-days year month))
                (let ((m (if (= month 12) 1 (+ month 1)))
                      (y (if (= month 12) (+ year 1) year)))
                  (and (<= y 65535) (loop y m (- day (month-days year month))))))
               (else (date-value year month day (list-ref date 3) (list-ref date 4)))))))
(def (month-shift date count)
  (let* ((total (+ (* (car date) 12) (- (cadr date) 1) count))
         (year (quotient total 12)) (month (+ (modulo total 12) 1)))
    (date-value year month 1)))
(def (strip-timestamp text)
  (let* ((text (org-trim text)) (end (string-length text)))
    (if (and (>= end 2)
             (or (and (char=? (string-ref text 0) #\<) (char=? (string-ref text (- end 1)) #\>))
                 (and (char=? (string-ref text 0) #\[) (char=? (string-ref text (- end 1)) #\]))))
      (substring text 1 (- end 1)) text)))
(def (unsigned-exact text max)
  ;; Clocktable source numbers do not accept whitespace or a leading plus.
  (and (string=? text (org-trim text)) (> (string-length text) 0)
       (not (char=? (string-ref text 0) #\+)) (org-unsigned-value text max)))
(def (date-prefix raw)
  (let* ((text (strip-timestamp raw)) (end (string-length text)))
    (and (>= end 10) (char=? (string-ref text 4) #\-) (char=? (string-ref text 7) #\-)
         (let ((date (date-value (unsigned-exact (substring text 0 4) 65535)
                                (unsigned-exact (substring text 5 7) 255)
                                (unsigned-exact (substring text 8 10) 255))))
           (and date (cons date (substring text 10 end)))))))
(def (time-token raw)
  (let* ((text (org-trim-marks raw '(#\< #\> #\[ #\] #\" #\' #\, #\;)))
         (colon (org-find text ":")) (end (string-length text)))
    (and colon (not (org-find text ":" (+ colon 1)))
         (let* ((hour (unsigned-exact (substring text 0 colon) 255))
                (start (+ colon 1)) (until (value-digit-end text start))
                (minute (and (= (- until start) 2)
                             (unsigned-exact (substring text start until) 255))))
           (and hour minute (< hour 24) (< minute 60) (list hour minute))))))
(def (org-clock-bound raw role)
  (unless (member role '("start" "end")) (error "invalid clock bound role" role))
  (let (date-rest (date-prefix (strip-timestamp (org-parameter-text raw))))
    (and date-rest
         (let* ((time (ormap time-token (org-value-words (cdr date-rest))))
                (date (car date-rest))
                (date (if time (append (list (car date) (cadr date) (caddr date)) time)
                        (if (string=? role "end") (day-shift date 1) date))))
           (and date (bound-row date))))))
(def (marker-parts text marker)
  (let (split (org-find text marker))
    (and split (let ((year (unsigned-exact (substring text 0 split) 65535))
                     (number (unsigned-exact (substring text (+ split 2) (string-length text)) 255)))
                 (and year number (cons year number))))))
(def (week-start year week)
  (and (< year 65535) (<= 1 week 53)
       (let* ((jan4 (date-value year 1 4)) (next4 (date-value (+ year 1) 1 4))
              (monday (day-shift jan4 (- (modulo (+ (day-number jan4) 3) 7))))
              (next-monday (day-shift next4 (- (modulo (+ (day-number next4) 3) 7))))
              (start (and monday (day-shift monday (* (- week 1) 7)))))
         (and start next-monday (< (day-number start) (day-number next-monday)) start))))
(def (org-clock-window raw)
  (let* ((text (org-parameter-text raw)) (end (string-length text))
         (quarter (marker-parts text "-Q")) (week (marker-parts text "-W"))
         (date-rest (date-prefix text))
         (month-date (and (= end 7) (char=? (string-ref text 4) #\-)
                          (date-value (unsigned-exact (substring text 0 4) 65535)
                                      (unsigned-exact (substring text 5 7) 255) 1)))
         (year-date (and (= end 4) (date-value (unsigned-exact text 65535) 1 1)))
         (pair
          (cond ((and quarter (<= 1 (cdr quarter) 4))
                 (let (start (date-value (car quarter) (+ 1 (* 3 (- (cdr quarter) 1))) 1))
                   (cons start (month-shift start 3))))
                ((and week (<= 1 (cdr week) 53))
                 (let (start (week-start (car week) (cdr week)))
                   (and start (cons start (day-shift start 7)))))
                (date-rest (and (string=? (org-trim (cdr date-rest)) "")
                                (cons (car date-rest) (day-shift (car date-rest) 1))))
                (month-date (cons month-date (month-shift month-date 1)))
                (year-date (cons year-date (date-value (+ (car year-date) 1) 1 1)))
                (else #f))))
    (and pair (car pair) (cdr pair) (append (bound-row (car pair)) (bound-row (cdr pair))))))
