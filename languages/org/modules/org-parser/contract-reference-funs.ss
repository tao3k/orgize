;;; -*- Gerbil -*-
;;; Inert CONTRACT_ORG source references; path execution remains a host role.
(import (only-in "text-funs.ss" org-trim org-find org-prefix-at?)
        (only-in "property-token-funs.ss" org-ascii-lower org-value-words))
(export org-contract-reference org-contract-values org-contract-aliases org-block-parameter org-severity
        org-contract-policy org-contract-block-plans org-contract-qualified-link? org-property-schema-reference
        org-sdd-parent-reference org-workspace-link-key org-workspace-link-role)
(def (org-sdd-parent-reference value)
  (let* ((raw (org-trim value)) (inner (wrapped-inner raw "[[id:" "]]"))
         (split (and inner (org-find inner "][")))
         (target (cond (inner (nonempty (if split (substring inner 0 split) inner)))
                       ((org-prefix-at? raw "id:" 0) (nonempty (substring raw 3 (string-length raw))))
                       (else #f)))
         (label (and split (nonempty (substring inner (+ split 2) (string-length inner))))))
    (if (string=? raw "") '() (list (list raw (or target "") (or label ""))))))
(def (org-workspace-link-key path)
  (let* ((split (org-find path "::")) (base (org-trim (if split (substring path 0 split) path))))
    (if (or (string=? base "")
            (and (org-find base ":") (not (member (org-workspace-link-role base) '("id" "footnote" "coderef")))))
      '() (list (list base)))))
(def (org-workspace-link-role key)
  (cond ((org-prefix-at? key "id:" 0) "id") ((org-prefix-at? key "#" 0) "custom-id")
        ((org-prefix-at? key "fn:" 0) "footnote") ((org-prefix-at? key "coderef:" 0) "coderef")
        (else "other")))
(def (last-find text pattern)
  (let loop ((i 0) (last #f))
    (let (next (org-find text pattern i)) (if next (loop (+ next 1) next) last))))
(def (strip-prefix text prefix)
  (if (org-prefix-at? text prefix 0) (substring text (string-length prefix) (string-length text)) text))
(def (wrapped-inner text prefix suffix)
  (let ((n (string-length text)) (a (string-length prefix)) (b (string-length suffix)))
    (and (>= n (+ a b)) (org-prefix-at? text prefix 0) (org-prefix-at? text suffix (- n b))
         (substring text a (- n b)))))
(def (file-reference? value)
  (or (org-prefix-at? value "./" 0) (org-prefix-at? value "../" 0) (org-prefix-at? value "/" 0)
      (let (n (string-length value)) (and (>= n 4) (org-prefix-at? value ".org" (- n 4))))
      (org-find value "/") (org-find value "\\")))
(def (reference-path text)
  (let (text (strip-prefix (org-trim text) "./"))
    (and (not (string=? text "")) (not (org-prefix-at? text "/" 0))
         (list->string (map (lambda (ch) (if (char=? ch #\\) #\/ ch)) (string->list text))))))
(def (reference-row raw path id)
  (list raw (or path "") (if path "true" "false") (or id "") (if id "true" "false")))
(def (nonempty text) (let (v (org-trim text)) (and (not (string=? v "")) v)))
(def (org-contract-reference value)
  (let* ((raw (org-trim value)) (inner (wrapped-inner raw "[[" "]]"))
         (split (and inner (org-find inner "][")))
         (target (and inner (org-trim (if split (substring inner 0 split) inner))))
         (description (and split (nonempty (substring inner (+ split 2) (string-length inner)))))
         (target (and target (org-trim (strip-prefix target "file:"))))
         (hash (and target (org-find target "#")))
         (linked? (and target (not (string=? target "")) (or hash (file-reference? target)))))
    (cond ((string=? raw "") (reference-row raw #f #f))
          (linked? (if hash (reference-row raw (reference-path (substring target 0 hash))
                                          (nonempty (substring target (+ hash 1) (string-length target))))
                    (reference-row raw (reference-path target) description)))
          (else
           (let* ((macro (wrapped-inner raw "{{{" "}}}"))
                  (macro (and macro (org-trim macro)))
                  (start (and macro (org-find macro "("))) (end (and macro (last-find macro ")")))
                  (argument (and start end (> end (+ start 1)) (nonempty (substring macro (+ start 1) end))))
                  (normal (or argument raw)) (file (strip-prefix normal "file:")) (hash (org-find file "#")))
             (cond (hash (reference-row raw (reference-path (substring file 0 hash))
                                        (nonempty (substring file (+ hash 1) (string-length file)))))
                   ((file-reference? file) (reference-row raw file #f))
                   (else (reference-row raw #f normal))))))))
(def (org-contract-values text)
  (let (n (string-length text))
    (let loop ((i 0) (start #f) (square 0) (brace 0) (out '()))
      (if (= i n) (reverse (if start (cons (substring text start n) out) out))
        (let (ch (string-ref text i))
          (if (and (= square 0) (= brace 0) (or (memv (char->integer ch) '(9 10 11 12 13 32)) (char=? ch #\,)))
            (loop (+ i 1) #f square brace (if start (cons (substring text start i) out) out))
            (loop (+ i 1) (or start i)
                  (max 0 (+ square (cond ((char=? ch #\[) 1) ((char=? ch #\]) -1) (else 0))))
                  (max 0 (+ brace (cond ((char=? ch #\{) 1) ((char=? ch #\}) -1) (else 0)))) out)))))))
(def (org-contract-aliases raw)
  (org-value-words (list->string (map (lambda (ch) (if (char=? ch #\,) #\space ch)) (string->list raw)))))
(def (org-block-parameter raw key)
  (block-parameter-parts (org-value-words raw) key))
(def (block-parameter-parts parts key)
  (let loop ((parts parts))
    (and (pair? parts) (if (string=? (car parts) key) (and (pair? (cdr parts)) (cadr parts)) (loop (cdr parts))))))

;;; One parse-local plan per ordered block. No cross-document memoization.
;;; Absence is explicit: empty strings are not overloaded as optional values.
(def (org-contract-block-plans fields)
  (unless (= (modulo (length fields) 3) 0)
    (error "invalid contract block plan arity"))
  (let loop ((fields fields) (rows '()))
    (if (null? fields) (reverse rows)
      (let* ((language (car fields)) (name (cadr fields)) (raw (caddr fields))
             (parts (org-value-words raw))
             (parameter-name (block-parameter-parts parts ":name"))
             (severity (block-parameter-parts parts ":severity")))
        (loop (cdddr fields)
              (cons (list (org-contract-policy "language" language)
                          (org-contract-policy "name" name)
                          (org-contract-policy "named-id" name)
                          (if parameter-name "true" "false") (or parameter-name "")
                          (if severity "true" "false") (or severity "")) rows))))))
(def (org-severity raw)
  (let (v (org-ascii-lower (org-trim raw)))
    (cond ((string=? v "error") "error") ((member v '("warn" "warning")) "warning") (else #f))))

;;; Closed source roles; typed graph lookup and filesystem effects stay with the host.
(def (suffix? value suffix)
  (let ((n (string-length value)) (m (string-length suffix)))
    (and (>= n m) (org-prefix-at? value suffix (- n m)))))
(def (org-contract-policy mode raw)
  (let* ((value (org-trim raw)) (lower (org-ascii-lower value)))
    (cond
     ((string=? mode "name") value)
     ((string=? mode "kind") (if (string=? value "org-elements") value "other"))
     ((string=? mode "scope") (if (member lower '("document" "subtree")) lower "other"))
     ((string=? mode "named-id")
      (if (or (string=? value "") (suffix? value ".message") (suffix? value ".fix")) "" value))
     ((string=? mode "language")
      (cond ((member lower '("org-elements-query" "org-elements-query-expr" "org-elements-expr")) "query")
            ((string=? lower "org-elements-selector") "selector")
            ((string=? lower "org-elements-expect") "expect")
            ((string=? lower "org-contract") "contract")
            ((string=? lower "jinja2") "template")
            (else "other")))
     (else (error "invalid native contract policy" mode)))))
(def (org-contract-qualified-link? raw path id)
  (and (wrapped-inner raw "[[" "]]") (not (string=? path "")) (not (string=? id ""))))
(def (org-property-schema-reference value)
  (let* ((raw (org-trim value)) (link (wrapped-inner raw "[[" "]]"))
         (split (and link (org-find link "][")))
         (target (and link (org-trim (if split (substring link 0 split) link))))
         (macro (wrapped-inner raw "{{{" "}}}")) (macro (and macro (org-trim macro)))
         (start (and macro (org-find macro "("))) (end (and macro (last-find macro ")")))
         (argument (and start end (> end (+ start 1)) (nonempty (substring macro (+ start 1) end))))
         (hash (org-find raw "#")) (path (if hash (substring raw 0 hash) raw))
         (query (org-find path "?")) (path (if query (substring path 0 query) path)))
    (cond ((string=? raw "") (list raw "" "empty"))
          ((and target (org-prefix-at? target "file:" 0)) (list raw target "org-file-link"))
          (argument (list raw argument "macro"))
          ((or (org-prefix-at? path "file:" 0) (org-prefix-at? path "./" 0) (org-prefix-at? path "../" 0)
               (suffix? path ".json") (suffix? path ".toml") (suffix? path ".yaml") (suffix? path ".yml")
               (org-find path "/")) (list raw raw "file"))
          (else (list raw raw "contract-id")))))
