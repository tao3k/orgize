;;; -*- Gerbil -*-
;;; Pure downstream metadata grammar; graph traversal and arithmetic are host roles.
(import (only-in "text-funs.ss" org-trim org-prefix-at? org-find)
        (only-in "property-token-funs.ss" org-value-words org-ascii-lower org-trim-marks org-unsigned-value)
        (only-in "duration-funs.ss" value-digit? value-digit-end value-two-digits))
(export org-datetree-title org-timestamp-sort-key org-column-values org-clock-scope
        org-column-precision org-checkbox-done? org-column-summary-kind org-clock-tree-level)
(def (org-column-summary-kind operator)
  (let (entry (assoc operator '(("+" . "numeric-sum") ("$" . "currency")
               ("min" . "numeric-min") ("max" . "numeric-max") ("mean" . "numeric-mean")
               ("X" . "checkbox-state") ("X/" . "checkbox-count") ("X%" . "checkbox-percent")
               (":" . "duration-sum") (":min" . "duration-min") (":max" . "duration-max")
               (":mean" . "duration-mean") ("@min" . "age-min") ("@max" . "age-max")
               ("@mean" . "age-mean") ("est+" . "estimate"))))
    (if entry (cdr entry) "custom")))
(def (unsigned raw max)
  (and (string=? raw (org-trim raw)) (org-unsigned-value raw max)))
(def (prefix-number text start end max)
  (and (<= end (string-length text)) (unsigned (substring text start end) max)))
(def (org-datetree-title mode text)
  (let ((year (prefix-number text 0 4 65535))
        (month (and (org-prefix-at? text "-" 4) (prefix-number text 5 7 255)))
        (day (and (org-prefix-at? text "-" 7) (prefix-number text 8 10 255))))
    (cond ((string=? mode "year") (if year (list (list (number->string year))) '()))
          ((string=? mode "month") (if (and year month) (list (map number->string (list year month))) '()))
          ((string=? mode "day") (if (and year month day) (list (map number->string (list year month day))) '()))
          (else (error "invalid native datetree role" mode)))))
(def (date-at text i)
  (and (<= (+ i 10) (string-length text))
       (andmap (lambda (j) (value-digit? (string-ref text (+ i j)))) '(0 1 2 3 5 6 8 9))
       (org-prefix-at? text "-" (+ i 4)) (org-prefix-at? text "-" (+ i 7))
       (list (string->number (substring text i (+ i 4)))
             (value-two-digits text (+ i 5)) (value-two-digits text (+ i 8)))))
(def (sort-time text start)
  (let loop ((i start))
    (cond ((> (+ i 5) (string-length text)) '(0 0))
          ((and (value-two-digits text i) (org-prefix-at? text ":" (+ i 2))
                (value-two-digits text (+ i 3)))
           (list (value-two-digits text i) (value-two-digits text (+ i 3))))
          ((memv (string-ref text i) '(#\> #\])) '(0 0))
          (else (loop (+ i 1))))))
(def (org-timestamp-sort-key text)
  (let loop ((i 0))
    (if (> (+ i 10) (string-length text)) '()
      (let (date (date-at text i))
        (if date (list (map number->string (append date (sort-time text (+ i 10)))))
          (loop (+ i 1)))))))
(def (ascii-property? ch)
  (or (char<=? #\a ch #\z) (char<=? #\A ch #\Z) (value-digit? ch) (memv ch '(#\_ #\-))))
(def (ascii-upper text)
  (list->string (map (lambda (ch) (if (char<=? #\a ch #\z)
                                  (integer->char (- (char->integer ch) 32)) ch)) (string->list text))))
(def (optional-text value) (let (v (org-trim value)) (and (not (string=? v "")) v)))
(def (last-find text pattern start)
  (let loop ((i start) (last #f))
    (let (next (org-find text pattern i)) (if next (loop (+ next 1) next) last))))
(def (column-value raw)
  (and (org-prefix-at? raw "%" 0)
       (let* ((n (string-length raw)) (width-end (value-digit-end raw 1))
              (width (and (> width-end 1) (unsigned (substring raw 1 width-end) 18446744073709551615)))
              (property-end (let loop ((i width-end))
                              (if (and (< i n) (ascii-property? (string-ref raw i))) (loop (+ i 1)) i)))
              (property (substring raw width-end property-end))
              (title-close (and (org-prefix-at? raw "(" property-end) (org-find raw ")" (+ property-end 1))))
              (title (and title-close (substring raw (+ property-end 1) title-close)))
              (tail (if title-close (+ title-close 1) property-end))
              (summary-close (and (org-prefix-at? raw "{" tail) (last-find raw "}" (+ tail 1))))
              (summary (and summary-close (substring raw (+ tail 1) summary-close)))
              (split (and summary (org-find summary ";")))
              (operator (and summary (optional-text (if split (substring summary 0 split) summary))))
              (format (and split (optional-text (substring summary (+ split 1) (string-length summary))))))
         (and (not (string=? property ""))
              (list (ascii-upper property) (or title "") (if title "true" "false")
                    (if width (number->string width) "") (or operator "") (or format "") raw)))))
(def (org-column-values text)
  (let loop ((tokens (org-value-words text)) (rows '()))
    (if (null? tokens) (reverse rows)
      (let (row (column-value (car tokens)))
        (loop (cdr tokens) (if row (cons row rows) rows))))))
(def (org-clock-scope text)
  (let* ((value (org-ascii-lower (org-trim-marks (org-trim-marks text '(#\")) '(#\'))))
         (level (and (org-prefix-at? value "tree" 0)
                     (unsigned (substring value 4 (string-length value)) 18446744073709551615))))
    (cond ((member value '("nil" "file" "subtree" "tree" "agenda" "agenda-with-archives" "file-with-archives")) value)
          (level "tree-level")
          ((andmap ascii-property? (string->list value)) "unknown")
          (else "external"))))
(def (org-clock-tree-level text)
  (let (value (org-ascii-lower (org-trim-marks (org-trim-marks text '(#\")) '(#\'))))
    (and (org-prefix-at? value "tree" 0)
         (unsigned (substring value 4 (string-length value)) 18446744073709551615))))
(def (org-column-precision raw)
  (let* ((text (org-trim raw)) (n (string-length text)))
    (and (>= n 3) (org-prefix-at? text "%." 0) (org-prefix-at? text "f" (- n 1))
         (unsigned (substring text 2 (- n 1)) 18446744073709551615))))
(def (org-checkbox-done? raw)
  (let* ((text (org-trim raw)) (n (string-length text)))
    (or (member text '("[X]" "[100%]"))
        (and (>= n 2) (org-prefix-at? text "[" 0) (org-prefix-at? text "]" (- n 1))
             (let* ((inner (substring text 1 (- n 1))) (split (org-find inner "/"))
                    (done (and split (org-unsigned-value (substring inner 0 split) 18446744073709551615)))
                    (total (and split (org-unsigned-value (substring inner (+ split 1) (string-length inner)) 18446744073709551615))))
               (and done total (> total 0) (= done total)))))))
