;;; -*- Gerbil -*-
;;; Closed native property/lifecycle/metadata value plans, not an evaluator.
(import (only-in "text-funs.ss" org-trim org-space? org-find)
        (only-in "unicode-funs.ss" org-unicode-lower)
        (only-in "duration-funs.ss" org-duration-seconds value-digit? value-ascii-space-end)
        (only-in "time-funs.ss" org-headline-time org-timer-stamps)
        (only-in "property-token-funs.ss" org-unsigned-value org-ascii-lower org-value-words org-parameter-text
                 org-property-tokens org-clock-property-names org-descriptor-key
                 org-descriptor-name org-statistic-cookie org-tag-values)
        (only-in "clock-window-funs.ss" org-clock-bound org-clock-window org-calendar-date)
        (only-in "link-protocol-funs.ss" org-uri-parts org-link-protocol-kind org-protocol-plan)
        (only-in "source-value-funs.ss" org-source-tokens org-unquote org-variable org-noweb org-var-target
                 org-include-lines org-include-mode org-column-list org-radio-marker
                 org-plot-options org-radio-header org-radio-options org-option-kind)
        (only-in "contract-reference-funs.ss" org-contract-reference org-contract-values org-contract-aliases org-block-parameter org-severity org-contract-policy org-contract-qualified-link? org-property-schema-reference org-sdd-parent-reference org-workspace-link-key org-workspace-link-role)
        (only-in "metadata-value-funs.ss" org-datetree-title org-timestamp-sort-key org-column-values org-clock-scope org-column-precision org-checkbox-done? org-column-summary-kind org-clock-tree-level)
        (only-in "agenda-match-funs.ss" org-agenda-match)
        (only-in "interactive-value-funs.ss" org-interactive-choice)
        (only-in "publishing-value-funs.ss" org-publishing-keyword org-publishing-keywords)
        (only-in "citation-export-value-funs.ss" org-citation-export-keywords org-citation-nocite)
        (only-in "source-header-policy-funs.ss" org-header-policy org-header-defaults org-header-language? org-alignment-cookie?))
(export org-value-plan org-priority-value org-archive-value org-value-words org-ascii-lower)
(def (org-priority-value raw)
  (let* ((text (org-trim raw)) (size (string-length text)))
    (cond ((and (= size 1) (char<=? #\A (string-ref text 0) #\Z))
           (list "letter" text))
          ((and (or (= size 1) (and (= size 2) (not (char=? (string-ref text 0) #\0))))
                (andmap value-digit? (string->list text)))
           (let (n (string->number text))
             (and (<= n 64) (list "numeric" (number->string n)))))
          (else #f))))
(def (org-archive-value raw)
  (let* ((text (org-trim raw)) (split (org-find text "::")))
    (list text (org-trim (if split (substring text 0 split) text))
          (if split (org-trim (substring text (+ split 2) (string-length text))) ""))))
(def (feed-status raw)
  (let* ((end (string-length raw))
         (lines (let loop ((start 0) (out '()))
                  (let* ((next (org-find raw "\n" start))
                         (text (org-trim (substring raw start (or next end))))
                         (out (if (string=? text "") out (cons text out))))
                    (if next (loop (+ next 1) out) (reverse out)))))
         (text (string-join lines "\n")) (size (string-length text))
         (count (let loop ((i 0) (total 0))
                  (if (= i size) total
                    (let (next (value-ascii-space-end text (+ i 1)))
                      (loop (+ i 1)
                            (if (and (char=? (string-ref text i) #\()
                                     (< next size) (char=? (string-ref text next) #\"))
                              (+ total 1) total)))))))
    (list text (if (or (= size 0) (char=? (string-ref text 0) #\()) "true" "false")
          (number->string count))))
(def (abbreviation-index protocol names)
  (let (protocol (org-ascii-lower protocol))
    (let loop ((rest names) (index 0))
      (cond ((null? rest) '())
            ((string=? protocol (org-ascii-lower (car rest))) (list (list (number->string index))))
            (else (loop (cdr rest) (+ index 1)))))))
(def (search-normalize kind raw value)
  (let* ((end (string-length raw))
         (text (if (string=? kind "regexp")
                 (let left ((start 0))
                   (if (and (< start end) (char=? (string-ref raw start) #\/))
                     (left (+ start 1))
                     (let right ((until end))
                       (if (and (> until start) (char=? (string-ref raw (- until 1)) #\/))
                         (right (- until 1)) (substring raw start until)))))
                 value)))
    (org-unicode-lower text)))
(def (org-value-plan fields)
  (unless (pair? fields) (error "missing native value operation"))
  (let* ((name (car fields)) (args (cdr fields))
         (expected (cond ((member name '("link-search-normalize" "contract-qualified-link")) 3)
                         ((member name '("publishing-keyword" "clock-bound" "link-protocol-kind" "org-protocol" "radio-marker" "block-parameter" "option-kind" "header-policy" "header-language" "contract-policy" "datetree-title")) 2)
                         (else 1))))
    (unless (cond ((member name '("publishing-keywords" "citation-export-keywords")) (even? (length args)))
                  ((string=? name "citation-nocite") #t)
                  ((string=? name "link-abbreviation-index") (pair? args))
                  (else (or (string=? name "include-mode") (= (length args) expected))))
      (error "invalid native value arity" name))
    (cond
      ((string=? name "publishing-keyword") (apply org-publishing-keyword args))
      ((string=? name "publishing-keywords") (org-publishing-keywords args))
      ((string=? name "citation-export-keywords") (org-citation-export-keywords args))
      ((string=? name "citation-nocite") (org-citation-nocite args))
      ((string=? name "agenda-date") (let (v (org-calendar-date (car args))) (if v (list (map number->string (list (car v) (cadr v) (caddr v)))) '())))
      ((string=? name "interactive-choice") (org-interactive-choice (car args)))
      ((string=? name "sdd-parent-reference") (org-sdd-parent-reference (car args)))
      ((string=? name "workspace-link-key") (org-workspace-link-key (car args)))
      ((string=? name "workspace-link-role") (list (list (org-workspace-link-role (car args)))))
      ((string=? name "agenda-match") (org-agenda-match (car args)))
      ((string=? name "datetree-title") (apply org-datetree-title args))
      ((string=? name "timestamp-sort-key") (org-timestamp-sort-key (car args)))
      ((string=? name "column-values") (org-column-values (car args)))
      ((string=? name "clock-scope") (list (list (org-clock-scope (car args)))))
      ((string=? name "clock-tree-level") (let (v (org-clock-tree-level (car args))) (if v (list (list (number->string v))) '())))
      ((string=? name "column-precision") (let (v (org-column-precision (car args))) (if v (list (list (number->string v))) '())))
      ((string=? name "checkbox-done") (list (list (if (org-checkbox-done? (car args)) "true" "false"))))
      ((string=? name "column-summary-kind") (list (list (org-column-summary-kind (car args)))))
      ((string=? name "header-policy") (list (list (apply org-header-policy args))))
      ((string=? name "header-defaults") (org-header-defaults (car args)))
      ((string=? name "header-language") (list (list (if (apply org-header-language? args) "true" "false"))))
      ((string=? name "alignment-cookie") (list (list (if (org-alignment-cookie? (car args)) "true" "false"))))
      ((string=? name "priority") (let (value (org-priority-value (car args))) (if value (list value) '())))
      ((string=? name "duration") (let (seconds (org-duration-seconds (car args)))
                    (if seconds (list (list (number->string seconds))) '())))
      ((string=? name "archive") (list (org-archive-value (car args))))
      ((string=? name "feed-status") (list (feed-status (car args))))
      ((string=? name "link-abbreviation-index") (abbreviation-index (car args) (cdr args)))
      ((string=? name "headline-time") (org-headline-time (car args)))
      ((string=? name "timer-stamps") (org-timer-stamps (car args)))
      ((string=? name "words") (list (org-value-words (car args))))
      ((string=? name "ascii-lower") (list (list (org-ascii-lower (car args)))))
      ((string=? name "trim-empty") (list (list (if (string=? (org-trim (car args)) "") "true" "false"))))
      ((string=? name "link-search-normalize") (list (list (apply search-normalize args))))
      ((string=? name "clock-bound") (let (row (apply org-clock-bound args)) (if row (list row) '())))
      ((string=? name "clock-window") (let (row (org-clock-window (car args))) (if row (list row) '())))
      ((string=? name "property-tokens") (list (org-property-tokens (car args))))
      ((string=? name "clock-property-names") (let (row (org-clock-property-names (car args))) (if row (list row) '())))
      ((string=? name "parameter-truthy") (list (list (if (member (org-ascii-lower (org-parameter-text (car args))) '("" "nil" "false" "0")) "false" "true"))))
      ((string=? name "property-truthy") (list (list (if (member (org-ascii-lower (org-trim (car args))) '("t" "true" "yes" "1")) "true" "false"))))
      ((string=? name "descriptor-key") (list (list (org-descriptor-key (car args)))))
      ((string=? name "descriptor-name") (let (name (org-descriptor-name (car args))) (if name (list (list name)) '())))
      ((string=? name "statistic-cookie") (list (org-statistic-cookie (car args))))
      ((string=? name "tag-values") (list (org-tag-values (car args))))
      ((string=? name "uri-split") (let (row (org-uri-parts (car args))) (if row (list row) '())))
      ((string=? name "link-protocol-kind") (list (list (apply org-link-protocol-kind args))))
      ((string=? name "org-protocol") (apply org-protocol-plan args))
      ((string=? name "source-tokens") (list (org-source-tokens (car args))))
      ((string=? name "header-tokens") (list (filter (lambda (s) (not (string=? s ""))) (org-property-tokens (car args)))))
      ((string=? name "source-unquote") (list (list (org-unquote (car args)))))
      ((string=? name "source-variable") (list (org-variable (car args))))
      ((string=? name "noweb-references") (list (org-noweb (car args))))
      ((string=? name "var-target") (let (v (org-var-target (car args))) (if v (list v) '())))
      ((string=? name "include-lines") (list (org-include-lines (car args))))
      ((string=? name "include-mode") (list (list (org-include-mode args))))
      ((string=? name "unsigned") (let (n (org-unsigned-value (car args) 18446744073709551615)) (if n (list (list (number->string n))) '())))
      ((string=? name "positive") (let (n (org-unsigned-value (car args) 18446744073709551615)) (if (and n (> n 0)) (list (list (number->string n))) '())))
      ((string=? name "column-list") (list (org-column-list (car args))))
      ((string=? name "plot-bool") (let (v (org-ascii-lower (car args))) (cond ((member v '("y" "yes" "t" "true")) '(("true"))) ((member v '("n" "no" "nil" "false")) '(("false"))) (else '()))))
      ((string=? name "radio-marker") (let (v (apply org-radio-marker args)) (if v (list (list v)) '())))
      ((string=? name "contract-reference") (list (org-contract-reference (car args))))
      ((string=? name "property-schema-reference") (list (org-property-schema-reference (car args))))
      ((string=? name "contract-policy") (list (list (apply org-contract-policy args))))
      ((string=? name "contract-qualified-link") (list (list (if (apply org-contract-qualified-link? args) "true" "false"))))
      ((string=? name "contract-values") (list (org-contract-values (car args))))
      ((string=? name "contract-aliases") (list (org-contract-aliases (car args))))
      ((string=? name "block-parameter") (let (v (apply org-block-parameter args)) (if v (list (list v)) '())))
      ((string=? name "severity") (let (v (org-severity (car args))) (if v (list (list v)) '())))
      ((string=? name "plot-options") (org-plot-options (car args)))
      ((string=? name "radio-header") (let (v (org-radio-header (car args))) (if v (list v) '())))
      ((string=? name "radio-options") (org-radio-options (car args)))
      ((string=? name "option-kind") (list (list (apply org-option-kind args))))
      (else (error "unknown native value operation" name)))))
