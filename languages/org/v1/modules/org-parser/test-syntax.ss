;;; -*- Gerbil -*-
;;; Domain-specific AST assertions for source-backed Org parser events.

(import (only-in :std/test check)
        (only-in "../../outline-events.ss" parse-org-outline-events))
(export check-org-ast org-events->ast org-events-cover-source?)

(def (org-events->ast events)
  (def (children rest reversed)
    (unless (pair? rest)
      (error "unclosed Org event node" events))
    (let (event (car rest))
      (case (car event)
        ((finish) (values (reverse reversed) (cdr rest)))
        ((token)
         (children (cdr rest) (cons (cdr event) reversed)))
        ((start)
         (let-values (((nested tail) (children (cdr rest) '())))
           (children tail (cons (cons (cadr event) nested) reversed))))
        (else (error "invalid Org parser event" event)))))
  (unless (and (pair? events) (eq? (caar events) 'start))
    (error "Org events require a root node" events))
  (let-values (((nested rest) (children (cdr events) '())))
    (unless (null? rest)
      (error "Org events contain trailing roots" rest))
    (cons (cadar events) nested)))

(def (org-events-cover-source? source events)
  (let ((size (u8vector-length (string->utf8 source))))
    (let loop ((rest events) (offset 0))
      (if (null? rest)
        (= offset size)
        (let (event (car rest))
          (if (eq? (car event) 'token)
            (and (= (caddr event) offset)
                 (<= offset (cadddr event) size)
                 (loop (cdr rest) (cadddr event)))
            (loop (cdr rest) offset)))))))

(defsyntax (check-org-ast stx)
  (syntax-case stx ()
    ((_ source expected)
     (syntax
      (let* ((text source)
             (events (parse-org-outline-events text)))
        (check (org-events-cover-source? text events) => #t)
        (check (org-events->ast events) => 'expected))))))
