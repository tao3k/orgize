;;; -*- Gerbil -*-
;;; Build-only product ownership, independent of grammar construction.
(import (only-in :yuanxu/module-system/building/artifacts clean-build-artifacts!))
(export document-fold-name inline-fold-name validate-fold-action clean-fold-products!)
(def document-fold-name 'parse-org-compiled-events)
(def inline-fold-name 'parse-org-compiled-inline-events)
(def (validate-fold-action profile action)
  (unless (member profile '("static" "dynamic")) (error "unknown Org fold build profile" profile))
  (unless (member action '("compile" "clean")) (error "unknown Org fold build action" action))
  (when (and (equal? action "clean") (not (equal? profile "dynamic")))
    (error "Org fold clean requires the dynamic package profile" profile)))
(def (decimal? text)
  (and (not (string-empty? text))
       (andmap (lambda (character) (char<=? #\0 character #\9)) (string->list text))))
(def (unit-name? name)
  (ormap
    (lambda (entry)
      (def base (symbol->string entry))
      (def prefix (string-append base "-part-"))
      (or (string=? name base)
          (and (string-prefix? prefix name)
               (> (string-length name) (string-length prefix))
               (let (index (substring name (string-length prefix) (string-length name)))
                 (and (decimal? index)
                      (string=? index (number->string (string->number index))))))))
    (list document-fold-name inline-fold-name)))
(def (product-unit name)
  (def stem
    (cond ((string-suffix? ".ssxi.ss" name)
           (substring name 0 (- (string-length name) 8)))
          ((member (path-extension name) '(".ss" ".ssi" ".scm")) (path-strip-extension name))
          ((let (extension (path-extension name))
             (and (> (string-length extension) 2) (string-prefix? ".o" extension)
                  (decimal? (substring extension 2 (string-length extension)))))
           (path-strip-extension name))
          (else #f)))
  (and stem
    ;; Core owns named runtime sections as well as numeric macro phases.
    (let (unit (car (string-split stem #\~)))
      (and (unit-name? unit) unit))))

(def (clean-fold-products! output)
  ;; Discover only the declared generated families. This is deletion ownership,
  ;; never publication/admission or permission to consume a generated product.
  (def names (map symbol->string (list document-fold-name inline-fold-name)))
  (def (remember name)
    (let (unit (product-unit name))
      (when (and unit (not (member unit names))) (set! names (cons unit names)))))
  (def (scan directory visit)
    (when (and (file-exists? directory) (eq? (file-type directory) 'directory))
      (for-each visit (directory-files directory))))
  (scan output remember)
  (scan (path-expand "lib/orgize/fold" output) remember)
  (scan (path-expand "lib/static" output)
    (lambda (name)
      (def prefix "orgize__fold__")
      (when (string-prefix? prefix name)
        (remember (substring name (string-length prefix) (string-length name))))))
  (unless (null? names)
    (clean-build-artifacts!
      (map (lambda (name) (string->symbol (string-append "orgize/fold/" name))) names)
      (path-expand "lib" output)))
  (displayln "CLEAN-OK native-org-document-and-inline") (force-output))
