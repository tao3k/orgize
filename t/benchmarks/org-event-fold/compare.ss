#!/usr/bin/env gxi
;; Compare admitted receipts, never reimplement ASP's sample statistics.
(import (only-in :asp-gerbil-scheme/benchmark-api benchmark-receipt-pass?))
(export main)

(def (field receipt key)
  (let (entry (assq key receipt))
    (if entry (cdr entry) (error "missing receipt field" key))))

(def (main baseline-path candidate-path (mode "admitted"))
  (unless (member mode '("admitted" "diagnostic"))
    (error "unknown ASP receipt comparison mode" mode))
  (let* ((baseline (call-with-input-file baseline-path read))
         (candidate (call-with-input-file candidate-path read))
         (left (field baseline 'benchmark))
         (right (field candidate 'benchmark)))
    (for-each
     (lambda (key)
       (unless (equal? (field baseline key) (field candidate key))
         (error "unmatched benchmark receipts" key)))
     '(schema sourceBytes sourceIdentity eventIdentity contract))
    (for-each
     (lambda (receipt)
       (unless (and (if (equal? mode "admitted")
                     (benchmark-receipt-pass? receipt)
                     (memq (field receipt 'status) '(pass fail)))
                    (= (field receipt 'sampleCount) 20)
                    (= (length (field receipt 'samplesNs)) 20)
                    (eq? (field receipt 'admissionStatistic) 'p95))
         (error "invalid admitted ASP receipt" receipt)))
     (list left right))
    (write
     `((baseline . ,baseline-path) (candidate . ,candidate-path)
       (comparisonMode . ,mode)
       (baselineGatePass . ,(benchmark-receipt-pass? left))
       (candidateGatePass . ,(benchmark-receipt-pass? right))
       (baselineEntityResults . ,(let (entry (assq 'entityResultSummary baseline))
                                   (if entry (cdr entry) 'unmeasured)))
       (candidateEntityResults . ,(let (entry (assq 'entityResultSummary candidate))
                                    (if entry (cdr entry) 'unmeasured)))
       (sourceIdentity . ,(field baseline 'sourceIdentity))
       (eventIdentity . ,(field baseline 'eventIdentity))
       (baselineP50Ns . ,(field left 'p50Ns))
       (candidateP50Ns . ,(field right 'p50Ns))
       (baselineP95Ns . ,(field left 'p95Ns))
       (candidateP95Ns . ,(field right 'p95Ns))))
    (newline)
    (displayln "ORG-EVENT-BENCHMARK-COMPARE-OK")))
