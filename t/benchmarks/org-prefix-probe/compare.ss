#!/usr/bin/env gxi
(import (only-in :asp-gerbil-scheme/benchmark-api micro-kernel-receipt-pass?))
(export main)
(def (field receipt key)
  (let (entry (assq key receipt))
    (if entry (cdr entry) (error "missing prefix receipt field" key))))
(def (main baseline-path candidate-path)
  (let* ((baseline (call-with-input-file baseline-path read))
         (candidate (call-with-input-file candidate-path read))
         (left (field baseline 'benchmark))
         (right (field candidate 'benchmark)))
    (for-each
     (lambda (key)
       (unless (equal? (field baseline key) (field candidate key))
         (error "unmatched prefix receipt" key)))
     '(schema line prefix contract))
    (for-each
     (lambda (receipt)
       (unless (and (micro-kernel-receipt-pass? receipt)
                    (= (field receipt 'operations) 100000)
                    (= (field receipt 'sampleCount) 20)
                    (= (length (field receipt 'samples)) 20)
                    (eq? (field receipt 'admissionStatistic) 'p50))
         (error "invalid ASP prefix receipt" receipt)))
     (list left right))
    ;; Emit ASP-owned fields unchanged, not independently derived statistics.
    (write `((baseline . ,baseline-path) (candidate . ,candidate-path)
             (baselineNsPerOpCeiling . ,(field left 'nsPerOpCeiling))
             (candidateNsPerOpCeiling . ,(field right 'nsPerOpCeiling))
             (baselineRuntimeStats . ,(field left 'runtimeStats))
             (candidateRuntimeStats . ,(field right 'runtimeStats))))
    (newline)
    (displayln "ORG-PREFIX-BENCHMARK-COMPARE-OK")))
