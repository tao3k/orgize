#!/usr/bin/env gxi
(import (only-in :asp-gerbil-scheme/benchmark-api benchmark-receipt-pass?)
        (only-in "runtime-counters.ss" helper-observation-valid?))
(export main)
(def (field receipt key)
  (let (entry (assq key receipt))
    (if entry (cdr entry) (error "missing helper receipt field" key))))
(def (main baseline-path candidate-path)
  (let* ((baseline (call-with-input-file baseline-path read))
         (candidate (call-with-input-file candidate-path read))
         (left (field baseline 'benchmark)) (right (field candidate 'benchmark)))
    (unless (eq? (field baseline 'schema) 'orgize.scheme-helper-state.asp.v3)
      (error "wrong helper receipt schema"))
    (for-each
     (lambda (key)
       (unless (equal? (field baseline key) (field candidate key))
         (error "unmatched helper receipt" key)))
     '(schema mode source initial forms helpers events contract diagnosticScope
       workloadScope workloadCallbacks))
    (for-each
     (lambda (receipt)
       (unless (helper-observation-valid?
                (field receipt 'mode) (field receipt 'diagnosticScope)
                (field receipt 'workloadScope) (field receipt 'workloadCallbacks)
                (field receipt 'runtimeCounters) (field receipt 'workloadCounters))
         (error "invalid helper observation mode/counters")))
     (list baseline candidate))
    (for-each
     (lambda (receipt)
       (unless (and (memq (field receipt 'status) '(pass fail))
                    (= (field receipt 'sampleCount) 20)
                    (= (length (field receipt 'samplesNs)) 20)
                    (eq? (field receipt 'admissionStatistic) 'p95))
         (error "invalid ASP diagnostic helper receipt")))
     (list left right))
    (write `((comparisonScope . matched-helper-native-not-runtime-qualification)
             (mode . ,(field baseline 'mode))
             (baselineGatePass . ,(benchmark-receipt-pass? left))
             (candidateGatePass . ,(benchmark-receipt-pass? right))
             (baselineBatchP50Ns . ,(field left 'p50Ns))
             (candidateBatchP50Ns . ,(field right 'p50Ns))
             (baselineBatchP95Ns . ,(field left 'p95Ns))
             (candidateBatchP95Ns . ,(field right 'p95Ns))))
    (newline)
    (when (eq? (field baseline 'mode) 'diagnostic)
      (write `((runtimeDiagnosticScope . asp-run-inclusive)
             (counterUnits . (process-cpu-ns vm-gc-cpu-ns vm-gc-wall-ns vm-gc-count))
             (baseline . ,(field baseline 'runtimeCounters))
             (candidate . ,(field candidate 'runtimeCounters))))
      (newline)
      (write `((runtimeDiagnosticScope . asp-callback-10-folds)
             (callbacks . 20)
             (counterUnits . (process-cpu-ns vm-gc-cpu-ns vm-gc-wall-ns vm-gc-count))
             (baseline . ,(field baseline 'workloadCounters))
             (candidate . ,(field candidate 'workloadCounters))))
      (newline))
    (displayln "ORG-HELPER-STATE-BENCHMARK-COMPARE-OK")))
