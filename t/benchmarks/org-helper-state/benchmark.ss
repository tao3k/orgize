;; ASP owns statistics; one sample = 10 folds, each with 128 nested helper calls.
;; Synthetic typed-helper kernel scenario, NOT production document concurrency.
((benchmarkKind . scenario-e2e)
 (rule . org-helper-state)
 (feature . native-scheme-parser)
 (optimizationFocus . "Request-local immutable helper default prototypes")
 (inputShape . "10 independent folds, 64 UTF-8 lines, two nested helpers per line")
 (expectedOutcome . "Independent lossless byte tape with no leaked defaults or arguments")
 (measurementPhases . (fold-batch assert-event-semantics assert-time-gate))
 (tags . (orgize scheme fold helpers))
 (batchOperations . 10)
 (sourceLines . 64)
 (helperCallsPerFold . 128)
 (sampleCount . 20)
 (target_total . 25ms)
 (regression_budget . 75ms)
 (max_total . 100ms)
 (expected_over_input_budget . 15ms)
 (targetRationale . "Matched helper kernel diagnostic, not the public Query SLO"))
